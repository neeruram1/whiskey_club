<turbo-frame id="bottle_<%= bottle.id %>">
  <%= link_to meeting_path(bottle.meeting, peek: 1),
        data: { turbo_frame: "bottle_#{bottle.id}" },
        class: "block group" do %>

    <div class="flex">
      <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold"></div>

      <div class="flex-1 ml-3 rounded-xl bg-black/35 px-4 py-4 sm:px-5
                  shadow-sm shadow-black/40 transition group-hover:bg-black/50
                  group-active:scale-[0.985]">
        <div class="space-y-1">
          <p class="body-base text-lagavulin-gold">
            <%= bottle.distillery %>
          </p>

          <p class="mt-2 heading-card text-lagavulin-gold">
            <%= bottle.name %>
          </p>

          <p class="body-sm text-lagavulin-gold/70">
            <%= bottle.meeting.date.strftime("%B %Y") %>
            · My Rating: <%= format_rating(user_rating_for(bottle, current_user, @user_ratings)) %>
            · Final Score: <%= format_rating(average_rating_for(bottle)) %>
          </p>
        </div>
      </div>

      <div class="ml-3 flex items-center text-lagavulin-gold/60 transition group-hover:text-lagavulin-gold">
        <svg class="h-4 w-4 sm:h-5 sm:w-5 transition-transform group-hover:translate-x-1"
             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </div>

  <% end %>
</turbo-frame>
