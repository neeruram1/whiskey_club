<%= form_with model: [meeting, bottle], local: true do |f| %>
  <div class="space-y-6">
    <div>
      <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
        <%= f.label :name, "Bottle Name", class: "sr-only" %>
        Bottle Name
      </label>
      <%= f.text_field :name,
            placeholder: "Enter bottle name",
            class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
    </div>
    <div>
      <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
        <%= f.label :distillery, "Distillery", class: "sr-only" %>
        Distillery
      </label>
      <%= f.text_field :distillery,
            placeholder: "Enter distillery name",
            class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
    </div>
    <div>
      <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
        <%= f.label :age, "Age", class: "sr-only" %>
        Age
      </label>
      <%= f.number_field :age, min: 0, max: 100,
            placeholder: "Enter age if applicable (years)",
            class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
    </div>
    <div>
      <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
        <%= f.label :bottle_type, "Bottle Type", class: "sr-only" %>
        Bottle Type
      </label>
      <%= f.text_field :bottle_type,
            placeholder: "Enter bottle type (e.g., Bourbon, Scotch, etc...)",
            class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
    </div>
    <div>
      <%= f.hidden_field :user_id, value: meeting.bottle_bringer_id %>
    </div>

    <div>
      This month’s pour comes courtesy of <strong><%= meeting.bottle_bringer.full_name %></strong>
    </div>

    <div class="flex flex-col gap-3 pt-2 md:flex-row md:items-center md:justify-between">
      <%= f.submit "Save Bottle", class: "form-btn" %>

      <%= link_to 'Tasting Night', meeting_path(meeting),
            class: "inline-flex items-center justify-center text-xs md:text-sm font-medium tracking-[0.18em] uppercase text-lagavulin-green hover:text-lagavulin-green/80" %>
      <%= link_to "Bottle Profile", bottle_path(bottle),
            class: "inline-flex items-center justify-center text-xs md:text-sm font-medium tracking-[0.18em] uppercase text-lagavulin-green hover:text-lagavulin-green/80" %>
    </div>
  </div>
<% end %>
