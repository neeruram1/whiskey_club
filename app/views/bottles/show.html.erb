<div class="relative min-h-screen bg-[#0f2a23] overflow-hidden">
  <!-- Background image -->
  <div
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-90"
    style="background-image: url(<%= asset_path 'charredoak.png' %>);">
  </div>

  <!-- Gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0b201b]/80 via-[#0b201b]/50 to-[#0b201b]/10"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:py-12 md:py-16">
    <!-- Top bar -->
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">
        Bottle profile
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs tracking-[0.3em] uppercase">
        <%= link_to meeting_path(@bottle.meeting),
              class: "inline-flex items-center gap-2 text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to meeting
        <% end %>

        <%= link_to archives_path,
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" do %>
          Back to archive
        <% end %>
      </div>
    </div>

    <!-- Header -->
    <header class="mb-8 space-y-2">
      <p class="text-[#E8D6A7]/70 text-xs sm:text-sm tracking-[0.3em] uppercase">
        <%= @bottle.distillery.presence || "Distillery" %>
      </p>

      <h1 class="text-[#E8D6A7] text-2xl sm:text-4xl md:text-5xl font-semibold tracking-wide leading-tight">
        <%= @bottle.name %>
      </h1>

      <p class="text-[#E8D6A7]/65 text-xs sm:text-sm tracking-widest">
        Tasted <span class="text-[#E8D6A7]/90"><%= @bottle.meeting.date.strftime("%B %d, %Y") %></span>
      </p>
    </header>

    <!-- Card -->
    <section class="rounded-3xl border border-lagavulin-gold/30 bg-black/25 p-5 sm:p-7 md:p-10 shadow-2xl shadow-black/50 backdrop-blur-sm">
      <div class="grid gap-6 md:grid-cols-2 md:gap-10">
        <!-- Left: attributes -->
        <div class="space-y-5">
          <% if @bottle.distillery.present? %>
            <div>
              <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">Distillery</p>
              <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
                <%= @bottle.distillery %>
              </p>
            </div>
          <% end %>

          <% if @bottle.bottle_type.present? %>
            <div>
              <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">Style</p>
              <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
                <%= @bottle.bottle_type %>
              </p>
            </div>
          <% end %>

          <% if @bottle.age.present? %>
            <div>
              <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">Age</p>
              <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
                <%= pluralize(@bottle.age, "year") %>
              </p>
            </div>
          <% end %>
        </div>

        <!-- Right: scores -->
        <div class="space-y-5 md:text-right">
          <div>
            <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">Date of tasting</p>
            <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
              <%= @bottle.meeting.date.strftime("%B %d, %Y") %>
            </p>
          </div>

          <div>
            <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">Final score</p>
            <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
              <%= @bottle.final_score.presence || "—" %>
            </p>
          </div>

          <div>
            <p class="text-xs tracking-[0.3em] uppercase text-lagavulin-gold/70">My rating</p>
            <p class="mt-1 text-[#E8D6A7] text-sm sm:text-base tracking-widest">
              <%= @bottle.user_rating(current_user)&.score || "—" %>
            </p>
          </div>
        </div>
      </div>
      <%= render "ratings/module", bottle: @bottle, current_user_rating: @current_user_rating %>


      <!-- Actions -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-3">
          <%= link_to "Rate bottle",
                meeting_path(@bottle.meeting),
                class: "inline-flex items-center justify-center form-btn w-full sm:w-auto" %>

          <%= link_to "Edit bottle",
                edit_meeting_bottle_path(@bottle.meeting),
                class: "inline-flex items-center justify-center btn w-full sm:w-auto" %>
        </div>

        <%= link_to "Back",
              request.referer || archives_path,
              class: "text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>
      </div>
    </section>
  </div>
</div>
