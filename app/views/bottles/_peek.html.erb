<turbo-frame id="bottle_<%= bottle.id %>">
  <div class="rounded-2xl border border-lagavulin-gold/35 bg-black/35 p-4 sm:p-5 shadow-sm shadow-black/40">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 space-y-1">
        <p class="label-xs text-lagavulin-gold/60">Bottle</p>

        <p class="mt-2 heading-card text-lagavulin-gold">
          <%= bottle.name %>
        </p>

        <p class="meta-sm text-lagavulin-gold/80">
          <%= bottle.distillery %>
          · <%= bottle.meeting.date.strftime("%B %d, %Y") %>
        </p>
      </div>

      <!-- Collapse -->
      <%= link_to meeting_path(bottle.meeting, peek: 0),
            data: { turbo_frame: "bottle_#{bottle.id}" },
            class: "shrink-0 label-sm text-lagavulin-gold/60 hover:text-lagavulin-gold transition" do %>
        Collapse
      <% end %>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl border border-lagavulin-gold/20 bg-black/25 p-3">
        <p class="label-sm text-lagavulin-gold/55">Style</p>
        <p class="mt-1 body-base text-lagavulin-gold">
          <%= bottle.bottle_type.presence || "—" %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/20 bg-black/25 p-3">
        <p class="label-sm text-lagavulin-gold/55">Age</p>
        <p class="mt-1 body-base text-lagavulin-gold">
          <%= bottle.age.present? ? pluralize(bottle.age, "year") : "—" %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/20 bg-black/25 p-3">
        <p class="label-sm text-lagavulin-gold/55">My rating</p>
        <p class="mt-1 body-base text-lagavulin-gold">
          <%= format_rating(user_rating_for(bottle, current_user, @user_ratings)) %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/20 bg-black/25 p-3">
        <p class="label-sm text-lagavulin-gold/55">Final score</p>
        <p class="mt-1 body-base text-lagavulin-gold">
          <%= format_rating(average_rating_for(bottle)) %>
        </p>
      </div>
    </div>

    <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-x-5 gap-y-2 label-sm">
        <%= link_to "View meeting details",
              meeting_path(bottle.meeting),
              data: { turbo: false },
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>

        <%= link_to "Edit",
              edit_bottle_path(bottle),
              data: { turbo_frame: "modal" },
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>
      </div>

      <div class="label-sm text-[#E8D6A7]/50">
        Press collapse to keep browsing
      </div>
    </div>
  </div>
</turbo-frame>
