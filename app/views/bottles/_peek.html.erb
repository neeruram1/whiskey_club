<turbo-frame id="bottle_<%= bottle.id %>">
  <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/20 p-4 sm:p-5 shadow-sm shadow-black/40">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 space-y-1">
        <p class="text-xs tracking-[0.32em] uppercase text-[#E8D6A7]/60">Bottle</p>

        <p class="text-[#E8D6A7] text-lg sm:text-xl font-semibold tracking-wide leading-tight">
          <%= bottle.name %>
        </p>

        <p class="text-[#E8D6A7]/80 text-xs sm:text-sm tracking-widest">
          <%= bottle.distillery %>
          · <%= bottle.meeting.date.strftime("%B %d, %Y") %>
        </p>
      </div>

      <!-- Collapse -->
      <%= link_to bottle_path(bottle, peek: 0),
            data: { turbo_frame: "bottle_#{bottle.id}" },
            class: "shrink-0 text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/60 hover:text-lagavulin-gold transition" do %>
        Collapse
      <% end %>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl border border-lagavulin-gold/15 bg-black/15 p-3">
        <p class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/55">Style</p>
        <p class="mt-1 text-sm text-[#E8D6A7]">
          <%= bottle.bottle_type.presence || "—" %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/15 bg-black/15 p-3">
        <p class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/55">Age</p>
        <p class="mt-1 text-sm text-[#E8D6A7]">
          <%= bottle.age.present? ? pluralize(bottle.age, "year") : "—" %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/15 bg-black/15 p-3">
        <p class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/55">My rating</p>
        <p class="mt-1 text-sm text-[#E8D6A7]">
          <%= bottle.user_rating(current_user)&.score || "—" %>
        </p>
      </div>

      <div class="rounded-xl border border-lagavulin-gold/15 bg-black/15 p-3">
        <p class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/55">Final score</p>
        <p class="mt-1 text-sm text-[#E8D6A7]">
          <%= bottle.final_score.presence || "—" %>
        </p>
      </div>
    </div>

    <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs tracking-[0.3em] uppercase">
        <%= link_to "Open full profile",
              bottle_path(bottle),
              data: { turbo: false },
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>

        <%= link_to "Edit",
              edit_meeting_bottle_path(bottle.meeting),
              data: { turbo: false },
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>

        <%= link_to "Rate",
              edit_meeting_bottle_path(bottle.meeting),
              data: { turbo: false },
              class: "text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" %>
      </div>

      <div class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/50">
        Press collapse to keep browsing
      </div>
    </div>
  </div>
</turbo-frame>
