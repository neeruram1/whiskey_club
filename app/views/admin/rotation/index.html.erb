<div class="relative min-h-screen">
  <div class="relative z-10 mx-auto w-full max-w-4xl px-4 py-10 sm:px-6 sm:py-12 md:py-16 space-y-8">

    <!-- Header -->
    <header class="space-y-2">
      <h1 class="heading-page text-lagavulin-gold">
        Spirit Guide Rotation
      </h1>
      <p class="body-base text-lagavulin-gold/80">
        The order members take turns guiding. New tastings prefill the next guide — always overridable.
      </p>
    </header>

    <%= render "admin/tabs" %>

    <% if @next_guide.present? %>
      <div class="card-glow rounded-2xl border border-lagavulin-gold/40 bg-black/40 p-5 sm:p-6 shadow-xl shadow-black/40">
        <p class="label-sm text-lagavulin-gold/70">Up next</p>
        <p class="mt-1 heading-sub text-lagavulin-gold"><%= @next_guide.full_name %></p>
      </div>
    <% end %>

    <!-- The rotation -->
    <section class="space-y-4">
      <h2 class="heading-section text-lagavulin-gold">In the rotation</h2>

      <% if @members.any? %>
        <ol class="space-y-2">
          <% @members.each_with_index do |member, idx| %>
            <li class="flex items-center gap-3 rounded-2xl border border-lagavulin-gold/30 bg-black/25 py-2.5 pl-3 pr-2 sm:pl-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-lagavulin-gold/50 bg-lagavulin-gold/10 label-sm text-lagavulin-gold">
                <%= idx + 1 %>
              </span>
              <span class="min-w-0 flex-1 truncate text-lagavulin-gold">
                <%= member.full_name %>
              </span>
              <div class="flex items-center gap-1">
                <%= button_to admin_move_rotation_path(member, direction: :up), class: "btn-mini px-3 py-2 #{'pointer-events-none opacity-30' if idx.zero?}",
                      disabled: idx.zero?, aria: { label: "Move #{member.first_name} up" } do %>↑<% end %>
                <%= button_to admin_move_rotation_path(member, direction: :down), class: "btn-mini px-3 py-2 #{'pointer-events-none opacity-30' if idx == @members.size - 1}",
                      disabled: idx == @members.size - 1, aria: { label: "Move #{member.first_name} down" } do %>↓<% end %>
                <%= button_to "Remove", admin_remove_rotation_path(member), method: :delete, class: "btn-mini px-3 py-2" %>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="body-sm italic text-lagavulin-gold/80">No one in the rotation yet. Add members below.</p>
      <% end %>
    </section>

    <!-- Available to add -->
    <% if @candidates.any? %>
      <section class="space-y-4">
        <h2 class="heading-section text-lagavulin-gold">Not in the rotation</h2>
        <ul class="space-y-2">
          <% @candidates.each do |member| %>
            <li class="flex items-center gap-3 rounded-2xl border border-lagavulin-gold/20 bg-black/20 py-2.5 pl-4 pr-2">
              <span class="min-w-0 flex-1 truncate text-lagavulin-gold/85"><%= member.full_name %></span>
              <%= button_to "Add", admin_add_rotation_path(member), class: "btn-mini px-4 py-2" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
