<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="heading-page text-lagavulin-gold">Encore Pours</h1>
      <p class="mt-2 body-base text-lagavulin-gold/85">Bottles you'd drink again or want to purchase</p>
    </div>

    <% if @wishlisted_bottles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @wishlisted_bottles.each do |bottle| %>
          <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-6 shadow-lg shadow-black/40 hover:border-lagavulin-gold/60 transition-all duration-200">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <p class="label-sm text-lagavulin-gold/80 mb-2">
                  <%= bottle.distillery.presence || "Distillery" %>
                </p>
                <h3 class="heading-section text-lagavulin-gold mb-1 leading-tight">
                  <%= link_to bottle.name, bottle, class: "hover:text-lagavulin-gold/80 transition-colors" %>
                </h3>
              </div>
              <%= button_to toggle_wishlist_bottle_path(bottle), method: :post, class: "ml-2 text-red-500 hover:text-red-600 transition-colors flex-shrink-0" do %>
                <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              <% end %>
            </div>

            <div class="space-y-3 mb-4">
              <div class="grid gap-3 grid-cols-2">
                <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-3">
                  <p class="label-xs text-lagavulin-gold/85">Type</p>
                  <p class="mt-1 body-sm text-lagavulin-gold">
                    <%= bottle.bottle_type.presence || "—" %>
                  </p>
                </div>
                <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-3">
                  <p class="label-xs text-lagavulin-gold/85">Age</p>
                  <p class="mt-1 body-sm text-lagavulin-gold">
                    <%= bottle.age.present? ? pluralize(bottle.age, "year") : "—" %>
                  </p>
                </div>
              </div>
              <% user_rating = bottle.user_rating(current_user) %>
              <% if user_rating %>
                <div class="rounded-2xl border border-lagavulin-gold/20 bg-lagavulin-gold/10 p-3">
                  <p class="label-xs text-lagavulin-gold/85">Your Rating</p>
                  <p class="mt-1 body-base font-semibold text-lagavulin-gold">
                    <%= user_rating.score %> <span class="text-lagavulin-gold/80 font-normal">/ 5</span>
                  </p>
                </div>
              <% end %>
            </div>

            <% if bottle.meeting %>
              <div class="pt-4 border-t border-lagavulin-gold/18">
                <p class="body-sm text-lagavulin-gold/85">
                  From <%= link_to bottle.meeting.date.strftime("%B %Y") + " Tasting", bottle.meeting, class: "text-lagavulin-gold hover:text-lagavulin-gold/80 transition-colors underline decoration-lagavulin-gold/30" %>
                </p>
                <p class="meta-xs text-lagavulin-gold/80 mt-1"><%= bottle.meeting.date.strftime("%B %d, %Y") %></p>
              </div>
            <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-16 rounded-3xl border border-lagavulin-gold/30 bg-black/25">
        <svg class="mx-auto h-16 w-16 text-lagavulin-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <h3 class="mt-4 heading-section text-lagavulin-gold">No bottles saved yet</h3>
        <p class="mt-2 body-base text-lagavulin-gold/85">Mark bottles you'd drink again or want to purchase</p>
        <div class="mt-6">
          <%= link_to "Browse Bottles", archives_path, class: "btn-mini" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
