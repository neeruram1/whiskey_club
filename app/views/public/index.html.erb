<div class="relative min-h-screen bg-[#0f2a23] overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[url('/assets/charredoak.png')] bg-cover bg-center opacity-90"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0f2a23]/60 via-[#0f2a23]/30 to-[#0f2a23]/0"></div>

  <!-- Page content -->
  <div class="relative mx-auto w-full max-w-5xl px-6 py-16 space-y-8 md:space-y-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-4">
      <h2 class="text-5xl uppercase tracking-widest text-shadow-md text-shadow-zinc-950 text-lagavulin-gold">
        Meetings
      </h2>
      <%= link_to 'Schedule a Meeting', new_meeting_path,
        class: "relative
                mx-auto 
                inline-block 
                px-3 
                py-2 
                items-center 
                rounded-3xl
                border 
                border-lagavulin-gold
                bg-black/30
                backdrop-blur-sm
                md:text-lg 
                tracking-[0.2em] 
                uppercase 
                font-medium 
                text-lagavulin-gold 
                shadow-lg 
                shadow-lagavulin-gold/20 
                transition-colors 
                duration-200 
                hover:bg-lagavulin-green-light 
                hover:text-lagavulin-green
                hover:font-semibold 
                focus-visible:outline-none 
                focus-visible:ring-4 
                focus-visible:ring-lagavulin-gold/40"
      %>
    </div>

    <section class="space-y-4 py-10">
      <h3 class="text-3xl uppercase tracking-widest text-shadow-md text-shadow-zinc-950 text-lagavulin-gold">
        Upcoming
      </h3>

    <% if @upcoming_meetings.any? %>
      <ul class="space-y-3 border-l border-lagavulin-gold/50 pl-6">
        <% @upcoming_meetings.each do |meeting| %>
            <li class="relative">
              <div class="rounded-xl bg-black/25 px-4 py-3 shadow-md shadow-black/40 w-full">
                <p class="text-[#E8D6A7] text-lg font-semibold tracking-[0.18em] uppercase">
                  <%= meeting.date.strftime("%B %d, %Y") %>
                </p>
                <p class="mt-1 text-md md:text-mdfont-medium text-[#E8D6A7]/85">
                  Bottle Bringer: <%= meeting.bottle_bringer.full_name %>
                </p>
              </div>
            </li>
        <% end %>
      </ul>
      <% else %>
        <p class="text-sm text-zinc-200">No upcoming meetings.</p>
      <% end %>
    </section>
    <section class="space-y-4">
      <h3 class="text-3xl uppercase tracking-widest text-shadow-md text-shadow-zinc-950 text-lagavulin-gold">
        Past
      </h3>

      <% if @past_meetings.any? %>
        <ul class="space-y-3 border-l border-lagavulin-gold/50 pl-6">
          <% @past_meetings.each do |meeting| %>
            <li class="relative">
              <div class="rounded-xl bg-black/25 px-4 py-3 shadow-md shadow-black/40 w-full">
                <p class="text-[#E8D6A7] text-lg font-semibold tracking-[0.18em] uppercase">
                  <%= meeting.date.strftime("%B %d, %Y") %>
                </p>
                <p class="mt-1 text-md md:text-md font-medium text-[#E8D6A7]/85">
                  Bottle Bringer: <%= meeting.bottle_bringer.full_name %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-zinc-200">No past meetings available.</p>
      <% end %>
    </section>
  </div>
</div>
