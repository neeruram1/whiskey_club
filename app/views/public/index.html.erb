<div class="relative min-h-screen overflow-x-hidden">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-6xl px-3 sm:px-4 md:px-6 py-10 sm:py-12 md:py-16 space-y-12">
    <!-- Welcome header -->
    <header class="space-y-2">
      <h1 class="heading-page text-lagavulin-gold">
        <span class="block sm:inline">Welcome back,</span>
        <span class="block sm:inline"><%= link_to current_user.full_name, user_path(current_user) %></span>
      </h1>
    </header>

    <!-- Modal frame for forms -->
    <%= turbo_frame_tag "modal" %>

    <!-- Hero: Next meeting -->
    <section class="space-y-6">
      <div>
        <h2 class="heading-sub text-lagavulin-gold">
          Next Tasting
        </h2>

        <p class="mt-3 heading-hero text-lagavulin-gold leading-tight">
          <% if @next_meeting.present? %>
            <span class="block sm:inline"><%= @next_meeting.date.strftime("%A") %>,</span>
            <span class="block sm:inline"><%= @next_meeting.date.strftime("%B %-d, %Y") %></span>
          <% else %>
            No meeting scheduled
          <% end %>
        </p>
      </div>

      <% if @next_meeting.present? %>
        <%= render "next_meeting_card", meeting: @next_meeting %>
      <% else %>
        <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-8 shadow-lg shadow-black/40 space-y-4">
          <p class="body-base text-lagavulin-gold/90">
            Nothing on the calendar yet.
          </p>
          <p class="body-sm text-lagavulin-gold/60">
            Schedule the next tasting when you're ready.
          </p>

          <div class="pt-2">
            <a href="<%= new_meeting_path %>" class="btn-mini w-full sm:w-auto" data-turbo-frame="modal">Schedule Tasting</a>
          </div>
        </div>
      <% end %>
    </section>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Member ledger -->
    <section class="space-y-6">
      <div>
        <h2 class="heading-sub text-lagavulin-gold">
          Your Stats
        </h2>
        <p class="mt-2 heading-page text-lagavulin-gold/90">
          Tasting History
        </p>
      </div>

      <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-4 sm:p-6 md:p-8 lg:p-10 shadow-lg shadow-black/40 space-y-10">

        <!-- Stat tiles -->
        <div class="grid gap-4 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-4 sm:p-5 min-h-[100px] flex flex-col justify-between transition hover:border-lagavulin-gold/50 hover:bg-black/35">
            <p class="stat-label text-lagavulin-gold/80">Ratings</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @ratings_count || 0 %>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-4 sm:p-5 min-h-[100px] flex flex-col justify-between transition hover:border-lagavulin-gold/50 hover:bg-black/35">
            <p class="stat-label text-lagavulin-gold/80" title="Your average rating across all bottles">Avg Score</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @avg_rating.present? ? number_with_precision(@avg_rating, precision: 1) : "—" %>
              <span class="text-lagavulin-gold/60 text-lg font-medium ml-1">/ 5</span>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-4 sm:p-5 min-h-[100px] flex flex-col justify-between transition hover:border-lagavulin-gold/50 hover:bg-black/35">
            <p class="stat-label text-lagavulin-gold/80">Bottles Brought</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @bottles_brought_count || 0 %>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-4 sm:p-5 min-h-[100px] flex flex-col justify-between transition hover:border-lagavulin-gold/50 hover:bg-black/35">
            <p class="stat-label text-lagavulin-gold/80">Meetings</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @meetings_attended || 0 %>
              <span class="text-lagavulin-gold/60 text-lg font-medium ml-1">/ <%= @total_past_meetings || 0 %></span>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-4 sm:p-5 min-h-[100px] flex flex-col justify-between transition hover:border-lagavulin-gold/50 hover:bg-black/35 col-span-2 sm:col-span-2 md:col-span-3 lg:col-span-1">
            <p class="stat-label text-lagavulin-gold/80" title="Your highest-rated bottle">Top Pick</p>
            <p class="mt-3 body-base font-semibold text-lagavulin-gold line-clamp-2 leading-snug">
              <%= @top_rated&.first&.name || "—" %>
            </p>
          </div>
        </div>

        <!-- Two-column ledger -->
        <div class="grid gap-8 md:grid-cols-2">

          <!-- Top rated -->
          <div class="space-y-4">
            <div class="flex items-end justify-between">
              <h3 class="heading-section text-lagavulin-gold">
                Your Top Three
              </h3>
              <span class="meta-xs text-lagavulin-gold/60">
                Highest Rated
              </span>
            </div>

            <% if @top_rated.present? %>
              <ul class="space-y-3">
                <% @top_rated.each_with_index do |bottle, idx| %>
                  <li>
                    <%= link_to bottle, class: "block group touch-manipulation" do %>
                      <div class="flex min-h-[56px] gap-2 sm:gap-3">
                        <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold flex-shrink-0"></div>

                        <div class="flex-1 min-w-0 rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-4 sm:p-5
                                    shadow-sm shadow-black/30 transition group-hover:bg-black/25 group-hover:border-lagavulin-gold/40 group-active:scale-[0.98]">
                          <p class="body-sm text-lagavulin-gold/70 truncate">
                            #<%= idx + 1 %> · <%= bottle.distillery.presence || "Distillery" %>
                            <% if bottle.meeting&.flight_night? %>
                              <span class="ml-1">✈️</span>
                            <% end %>
                          </p>
                          <p class="mt-2 text-base sm:text-lg font-semibold text-lagavulin-gold break-words line-clamp-2">
                            <%= bottle.name %>
                          </p>
                        </div>

                        <div class="flex items-center text-lagavulin-gold/60 transition group-hover:text-lagavulin-gold flex-shrink-0">
                          <svg class="h-5 w-5 transition-transform group-hover:translate-x-1"
                               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-6 space-y-2">
                <p class="body-sm text-lagavulin-gold/75">
                  No ratings yet.
                </p>
                <p class="meta-xs text-lagavulin-gold/50">
                  Start rating bottles at your next tasting
                </p>
              </div>
            <% end %>
          </div>

          <!-- Bottles brought -->
          <div class="space-y-4">
            <div class="flex items-end justify-between">
              <h3 class="heading-section text-lagavulin-gold">
                Your Bottles
              </h3>
              <span class="meta-xs text-lagavulin-gold/60">
                <%= @bottles_brought_count || 0 %> Total
              </span>
            </div>

            <% if @bottles_brought.present? && @bottles_brought.any? %>
              <ul class="space-y-3">
                <% @bottles_brought.order("meetings.date desc").each do |bottle| %>
                  <li>
                    <%= link_to bottle, class: "block group touch-manipulation" do %>
                      <div class="flex min-h-[56px] gap-2 sm:gap-3">
                        <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold flex-shrink-0"></div>

                        <div class="flex-1 min-w-0 rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-4 sm:p-5
                                    shadow-sm shadow-black/30 transition group-hover:bg-black/25 group-hover:border-lagavulin-gold/40 group-active:scale-[0.98]">
                          <p class="body-sm text-lagavulin-gold/70 truncate">
                            <% if bottle.meeting.flight_night? %>✈️ <% end %><%= bottle.distillery.presence || "Distillery" %>
                          </p>
                          <p class="mt-2 text-base sm:text-lg font-semibold text-lagavulin-gold break-words line-clamp-2">
                            <%= bottle.name %>
                          </p>
                        </div>

                        <div class="flex items-center text-lagavulin-gold/60 transition group-hover:text-lagavulin-gold flex-shrink-0">
                          <svg class="h-5 w-5 transition-transform group-hover:translate-x-1"
                               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-6 space-y-2">
                <p class="body-sm text-lagavulin-gold/75">
                  None yet.
                </p>
                <p class="meta-xs text-lagavulin-gold/70">
                  Bring a bottle to your next meeting to get started
                </p>
              </div>
            <% end %>
          </div>

        </div>

        <!-- New insights section -->
        <% if @taste_match.present? || @favorite_bringer.present? %>
          <div class="h-px bg-lagavulin-gold/18"></div>

          <div class="grid gap-8 lg:grid-cols-2">
            <!-- Taste match -->
            <% if @taste_match.present? %>
              <div class="space-y-4">
                <div class="flex items-end justify-between">
                  <h3 class="heading-section text-lagavulin-gold">
                    Closest Match
                  </h3>
                  <span class="meta-xs text-lagavulin-gold/60">
                    <%= @taste_match[:similarity].round(1) %> / 5 Match
                  </span>
                </div>

                <%= link_to user_path(@taste_match[:user]), class: "block group" do %>
                  <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-4 sm:p-5 lg:p-6 space-y-3 hover:bg-black/25 hover:border-lagavulin-gold/40 transition-all">
                    <div class="flex items-center justify-between gap-2 min-w-0">
                      <p class="text-lg sm:text-xl lg:text-2xl font-semibold text-lagavulin-gold truncate">
                        <%= @taste_match[:user].full_name %>
                      </p>
                      <div class="flex items-center gap-2">
                        <div class="rounded-full bg-lagavulin-gold/20 border border-lagavulin-gold/40 px-3 py-1">
                          <p class="meta-xs text-lagavulin-gold font-semibold">
                            <%= @taste_match[:shared_bottles] %> bottles
                          </p>
                        </div>
                        <svg class="w-5 h-5 text-lagavulin-gold/60 group-hover:text-lagavulin-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                    <p class="body-sm text-lagavulin-gold/70">
                      You've both rated <%= @taste_match[:shared_bottles] %> of the same bottles with similar scores.
                    </p>
                    <p class="meta-xs italic text-lagavulin-gold/55">
                      Based on bottles you've rated — their match may differ
                    </p>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Favorite bottle bringer -->
            <% if @favorite_bringer.present? %>
              <div class="space-y-4">
                <div class="flex items-end justify-between">
                  <h3 class="heading-section text-lagavulin-gold">
                    Favorite Curator
                  </h3>
                  <span class="meta-xs text-lagavulin-gold/60">
                    <%= @favorite_bringer[:avg_score] %> avg
                  </span>
                </div>

                <%= link_to user_path(@favorite_bringer[:bringer]), class: "block group" do %>
                  <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-4 sm:p-5 lg:p-6 space-y-3 hover:bg-black/25 hover:border-lagavulin-gold/40 transition-all">
                    <div class="flex items-center justify-between gap-2 min-w-0">
                      <p class="text-lg sm:text-xl lg:text-2xl font-semibold text-lagavulin-gold truncate">
                        <%= @favorite_bringer[:bringer].full_name %>
                      </p>
                      <div class="flex items-center gap-2">
                        <div class="rounded-full bg-lagavulin-gold/20 border border-lagavulin-gold/40 px-3 py-1">
                          <p class="meta-xs text-lagavulin-gold font-semibold">
                            <%= @favorite_bringer[:bottle_count] %> bottles
                          </p>
                        </div>
                        <svg class="w-5 h-5 text-lagavulin-gold/60 group-hover:text-lagavulin-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                    <p class="body-sm text-lagavulin-gold/70">
                      You've rated their <%= @favorite_bringer[:bottle_count] %> bottles highest on average. They know your palate!
                    </p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

      </div>
    </section>

  </div>
</div>
