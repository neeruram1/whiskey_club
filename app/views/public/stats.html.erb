<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-12 md:py-16 space-y-12">
    <!-- Header -->
    <header class="space-y-2">
      <h1 class="heading-page text-lagavulin-gold">
        Club Stats
      </h1>
      <p class="body-base text-lagavulin-gold/80">
        A look at our collective tasting journey
      </p>
    </header>

    <!-- Overview Stats -->
    <section class="space-y-6">
      <h2 class="heading-sub text-lagavulin-gold">
        By the Numbers
      </h2>

      <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-6 sm:p-8 md:p-10 shadow-lg shadow-black/40">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 min-h-[100px] flex flex-col justify-between">
            <p class="stat-label text-lagavulin-gold/80">Total Meetings</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @total_meetings %>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 min-h-[100px] flex flex-col justify-between">
            <p class="stat-label text-lagavulin-gold/80">Bottles Tasted</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @total_bottles %>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 min-h-[100px] flex flex-col justify-between">
            <p class="stat-label text-lagavulin-gold/80">Total Ratings</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @total_ratings %>
            </p>
          </div>

          <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 min-h-[100px] flex flex-col justify-between">
            <p class="stat-label text-lagavulin-gold/80">Club Avg Rating</p>
            <p class="mt-3 stat-value text-lagavulin-gold">
              <%= @club_avg_rating || "—" %>
              <span class="text-lagavulin-gold/60 text-lg font-medium ml-1">/ 5</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Top Bottles -->
    <section class="space-y-6">
      <h2 class="heading-sub text-lagavulin-gold">
        Hall of Fame
      </h2>

      <% if @top_bottle.present? || @controversial_bottle.present? %>
        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Top rated bottle -->
          <% if @top_bottle.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "🏆 Highest Rated", pill: "#{@top_bottle.avg_score.round(1)} / 5" } do %>
              <%= link_to meeting_path(@top_bottle.meeting), class: "block group" do %>
                <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 transition hover:bg-black/25 hover:border-lagavulin-gold/40 space-y-2">
                  <p class="body-sm text-lagavulin-gold/85"><%= @top_bottle.distillery %></p>
                  <p class="text-2xl font-semibold text-lagavulin-gold"><%= @top_bottle.name %></p>
                  <p class="meta-sm text-lagavulin-gold/85"><%= pluralize(@top_bottle.ratings.count, "rating") %></p>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <!-- Most controversial -->
          <% if @controversial_bottle.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "⚡ Most Divisive", pill: "#{@controversial_bottle.avg_score.round(1)} avg" } do %>
              <%= link_to meeting_path(@controversial_bottle.meeting), class: "block group" do %>
                <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 transition hover:bg-black/25 hover:border-lagavulin-gold/40 space-y-2">
                  <p class="body-sm text-lagavulin-gold/85"><%= @controversial_bottle.distillery %></p>
                  <p class="text-2xl font-semibold text-lagavulin-gold"><%= @controversial_bottle.name %></p>
                  <p class="meta-sm text-lagavulin-gold/85">Wide range of opinions</p>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%= render "shared/empty_state",
                   icon: "🥃",
                   title: "No superlatives yet",
                   message: "Bottles appear here once they’ve gathered at least 3 ratings. Keep tasting and rating!" %>
      <% end %>
    </section>

    <% if @golden_nose.present? || @tastemaker.present? || @hardest_rater.present? || @easiest_rater.present? %>
      <div class="h-px bg-lagavulin-gold/18"></div>

      <!-- Member Highlights -->
      <section class="space-y-6">
        <h2 class="heading-sub text-lagavulin-gold">
          Member Highlights
        </h2>

        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Golden Nose -->
          <% if @golden_nose.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "👃 Golden Nose", pill: "#{@golden_nose[:accuracy]} accuracy" } do %>
              <%= link_to user_path(@golden_nose[:user]), class: "block rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 space-y-2 transition hover:bg-black/25 hover:border-lagavulin-gold/40 group" do %>
                <p class="text-2xl font-semibold text-lagavulin-gold transition group-hover:text-lagavulin-gold/90"><%= @golden_nose[:user].full_name %></p>
                <p class="body-sm text-lagavulin-gold/85">Their ratings best predict the club average</p>
              <% end %>
            <% end %>
          <% end %>

          <!-- Tastemaker -->
          <% if @tastemaker.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "⭐ Tastemaker", pill: "#{@tastemaker[:avg_score]} avg" } do %>
              <%= link_to user_path(@tastemaker[:spirit_guide]), class: "block rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 space-y-2 transition hover:bg-black/25 hover:border-lagavulin-gold/40 group" do %>
                <p class="text-2xl font-semibold text-lagavulin-gold transition group-hover:text-lagavulin-gold/90"><%= @tastemaker[:spirit_guide].full_name %></p>
                <p class="body-sm text-lagavulin-gold/85">Their bottles consistently score highest</p>
              <% end %>
            <% end %>
          <% end %>

          <!-- Hardest rater -->
          <% if @hardest_rater.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "🎯 Toughest Critic", pill: "#{@hardest_rater.avg_score.round(1)} avg" } do %>
              <%= link_to user_path(@hardest_rater), class: "block rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 space-y-2 transition hover:bg-black/25 hover:border-lagavulin-gold/40 group" do %>
                <p class="text-2xl font-semibold text-lagavulin-gold transition group-hover:text-lagavulin-gold/90"><%= @hardest_rater.full_name %></p>
                <p class="body-sm text-lagavulin-gold/85">Has high standards and isn’t afraid to show it</p>
              <% end %>
            <% end %>
          <% end %>

          <!-- Easiest rater -->
          <% if @easiest_rater.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "😊 Most Generous", pill: "#{@easiest_rater.avg_score.round(1)} avg" } do %>
              <%= link_to user_path(@easiest_rater), class: "block rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 space-y-2 transition hover:bg-black/25 hover:border-lagavulin-gold/40 group" do %>
                <p class="text-2xl font-semibold text-lagavulin-gold transition group-hover:text-lagavulin-gold/90"><%= @easiest_rater.full_name %></p>
                <p class="body-sm text-lagavulin-gold/85">Finds something to love in every pour</p>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @most_poured_distillery.present? || @best_meeting.present? %>
      <div class="h-px bg-lagavulin-gold/18"></div>

      <!-- Fun Facts -->
      <section class="space-y-6">
        <h2 class="heading-sub text-lagavulin-gold">
          Fun Facts
        </h2>

        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Most poured distillery -->
          <% if @most_poured_distillery.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "🥃 Most Poured Distillery", pill: pluralize(@most_poured_distillery[1], "bottle") } do %>
              <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 space-y-2">
                <p class="text-2xl font-semibold text-lagavulin-gold"><%= @most_poured_distillery[0] %></p>
                <p class="body-sm text-lagavulin-gold/85">Our most-tasted distillery</p>
              </div>
            <% end %>
          <% end %>

          <!-- Best meeting -->
          <% if @best_meeting.present? %>
            <%= render layout: "public/superlative_card",
                       locals: { title: "✨ Best Meeting", pill: "#{@best_meeting.avg_score.round(1)} avg" } do %>
              <%= link_to meeting_path(@best_meeting), class: "block group" do %>
                <div class="rounded-2xl border border-lagavulin-gold/25 bg-black/15 p-5 transition hover:bg-black/25 hover:border-lagavulin-gold/40 space-y-2">
                  <p class="text-2xl font-semibold text-lagavulin-gold"><%= @best_meeting.date.strftime("%B %Y") %></p>
                  <% if @best_meeting.bottle_bringer.present? %>
                    <p class="body-sm text-lagavulin-gold/85">
                      Guided by <%= link_to @best_meeting.bottle_bringer.full_name, user_path(@best_meeting.bottle_bringer), class: "hover:text-lagavulin-gold transition" %>
                    </p>
                  <% end %>
                  <p class="meta-sm text-lagavulin-gold/85">The night with the highest-rated bottle</p>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
