<ul class="space-y-3 border-l border-lagavulin-gold/50 pl-6">
  <% meetings.each do |meeting| %>
    <li class="relative">
      <div class="rounded-xl bg-black/25 px-4 py-3 shadow-md shadow-black/40 w-full flex items-center justify-between">
        <div>
          <p class="text-[#E8D6A7] text-lg font-semibold tracking-widest uppercase">
            <%= meeting.date.strftime("%B %d, %Y") %>
          </p>
          <p class="mt-0.5 text-md font-medium text-[#E8D6A7]/85">
            This month's selection by <%= meeting.bottle_bringer.full_name %>
          </p>
        </div>
        <div class="ml-4 shrink-0">
          <%= link_to 'View Details', meeting_path(meeting), class: "btn" %>
        </div>

      </div>
    </li>
  <% end %>
</ul>

