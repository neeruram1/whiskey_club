<%= link_to meeting_path(meeting), class: "block group" do %>
  <div class="flex">
    <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold"></div>

    <div class="flex-1 ml-3 rounded-3xl border border-lagavulin-gold/20 bg-black/15 p-6 sm:p-7
                shadow-sm shadow-black/30 transition group-hover:bg-black/22 group-active:scale-[0.99]">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-2">
          <p class="text-[0.7rem] tracking-[0.32em] uppercase text-[#E8D6A7]/55">
            Hosted by <span class="text-[#E8D6A7]/80 tracking-widest normal-case sm:uppercase sm:tracking-[0.22em]"><%= meeting.bottle_bringer.full_name %></span>
          </p>

          <% if meeting.bottle.present? %>
            <p class="text-[#E8D6A7] text-lg sm:text-xl font-semibold tracking-wide">
              Featured bottle: <span class="font-normal tracking-widest"><%= meeting.bottle.name %></span>
            </p>
          <% else %>
            <p class="text-[#E8D6A7]/75 text-sm tracking-widest">
              Bottle not announced yet.
            </p>
          <% end %>
        </div>

        <div class="flex items-center gap-2 text-lagavulin-gold/70 transition group-hover:text-lagavulin-gold">
          <span class="text-[0.7rem] tracking-[0.32em] uppercase">Open</span>
          <svg class="h-4 w-4 sm:h-5 sm:w-5 transition-transform group-hover:translate-x-1"
               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
<% end %>
