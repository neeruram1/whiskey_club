<%= link_to meeting_path(meeting), class: "block group" do %>
  <div class="flex">
    <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold"></div>

    <div class="flex-1 ml-3 rounded-3xl border border-lagavulin-gold/20 bg-black/15 p-6 sm:p-7
                shadow-sm shadow-black/30 transition group-hover:bg-black/22 group-active:scale-[0.99]">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

        <div class="space-y-3">
          <!-- Date (quiet, editorial) -->
          <p class="text-[0.7rem] tracking-[0.32em] uppercase text-lagavulin-gold/60">
            <%= meeting.date.strftime("%A · %B %d, %Y") %>
          </p>

          <!-- Host -->
          <p class="text-[0.7rem] tracking-[0.32em] uppercase text-[#E8D6A7]/55">
            Hosted by
            <span class="text-[#E8D6A7]/85 tracking-widest normal-case sm:uppercase sm:tracking-[0.22em]">
              <%= meeting.bottle_bringer.full_name %>
            </span>
          </p>

          <!-- Featured bottle -->
          <% if meeting.bottle.present? %>
            <div class="pt-1">
              <p class="text-[0.7rem] tracking-[0.32em] uppercase text-[#E8D6A7]/50">
                Featured bottle
              </p>

              <p class="mt-2 text-[#E8D6A7] text-lg sm:text-xl font-semibold tracking-wide leading-snug">
                <span class="text-[#E8D6A7]/70 font-normal tracking-widest">
                  <%= meeting.bottle.distillery.presence || "Distillery" %> ·
                </span>
                <span class="tracking-widest font-normal"><%= meeting.bottle.name %></span>
              </p>
            </div>
          <% else %>
            <p class="text-sm tracking-widest text-[#E8D6A7]/70">
              Bottle not announced yet.
              <span class="text-[#E8D6A7]/50 text-[0.7rem] tracking-[0.32em] uppercase">Check back soon.</span>
            </p>
          <% end %>
        </div>

        <!-- Affordance -->
        <div class="flex items-center gap-2 text-lagavulin-gold/65 transition group-hover:text-lagavulin-gold">
          <span class="text-[0.7rem] tracking-[0.32em] uppercase">View</span>
          <svg class="h-4 w-4 sm:h-5 sm:w-5 transition-transform group-hover:translate-x-1"
               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>

      </div>
    </div>
  </div>
<% end %>
