<% meeting_is_today = meeting.date == Date.today %>
<% meeting_has_passed = meeting.date < Date.today %>
<% is_spirit_guide = current_user&.id == meeting.bottle_bringer_id %>
<% is_revealed = meeting.bottle.present? && meeting.bottle.revealed_at.present? %>

<%= link_to meeting_path(meeting), class: "block group touch-manipulation" do %>
  <div class="flex min-h-[120px]">
    <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold flex-shrink-0"></div>

    <div class="flex-1 ml-3 sm:ml-4 md:ml-5 rounded-3xl border border-lagavulin-gold/20 bg-black/15 p-4 sm:p-5 md:p-6 lg:p-7
                shadow-sm shadow-black/30 transition group-hover:bg-black/22 group-active:scale-[0.98]">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

        <div class="space-y-3">
          <!-- Date (quiet, editorial) -->
          <div class="flex items-center gap-2 flex-wrap">
            <p class="label-sm text-lagavulin-gold/60">
              <%= date_with_friendly(meeting.date, format: "%A · %B %d, %Y") %>
            </p>
            <% is_attending = current_user && meeting.attendees.exists?(id: current_user.id) %>
            <% if is_attending %>
              <span class="inline-flex items-center rounded-full bg-lagavulin-gold/10 border border-lagavulin-gold/30 px-2.5 py-0.5">
                <p class="label-xs text-lagavulin-gold font-medium">Attending</p>
              </span>
            <% end %>
          </div>

          <!-- Spirit Guide -->
          <% if meeting.bottle_bringer.present? %>
            <p class="label-sm text-lagavulin-gold/70">
              Guided by
              <span class="text-lagavulin-gold/85">
                <%= meeting.bottle_bringer.full_name %>
              </span>
            </p>
          <% elsif meeting.flight_night? %>
            <p class="label-sm text-lagavulin-gold/70">
              <span class="text-lagavulin-gold/85">✈️ Whiskey Flight Night</span>
            </p>
          <% end %>

          <!-- Featured bottle -->
          <% if meeting.bottle.present? && (is_revealed || is_spirit_guide) %>
            <div class="pt-1">
              <p class="label-sm text-lagavulin-gold/50">
                Featured bottle
              </p>

              <p class="mt-2 heading-sub text-lagavulin-gold leading-snug">
                <span class="text-lagavulin-gold/70 font-normal">
                  <%= meeting.bottle.distillery.presence || "Distillery" %> ·
                </span>
                <span class="font-normal"><%= meeting.bottle.name %></span>
              </p>
            </div>
          <% else %>
            <% meeting_is_today = meeting.date == Date.current %>
            <% meeting_has_passed = meeting.date < Date.current %>
            
            <div class="pt-1 space-y-2">
              <% if meeting_is_today && is_spirit_guide %>
                <p class="body-base font-semibold text-lagavulin-gold">
                  🥃 Ready to reveal the bottle!
                </p>
                <p class="label-sm text-lagavulin-gold/60">
                  Reveal it during the tasting.
                </p>
              <% elsif meeting_has_passed %>
                <p class="body-base text-lagavulin-gold/75">
                  Bottle details not yet added.
                </p>
                <p class="label-sm text-lagavulin-gold/50">
                  Complete the record by adding the bottle.
                </p>
              <% elsif !is_spirit_guide %>
                <p class="body-base text-lagavulin-gold/75">
                  Bottle not announced yet.
                </p>
                <p class="label-sm text-lagavulin-gold/50">
                  The spirit guide will reveal it during the tasting.
                </p>
              <% else %>
                <p class="body-base font-semibold text-lagavulin-gold">
                  🥃 Time to add the bottle!
                </p>
                <p class="label-sm text-lagavulin-gold/60">
                  Let the club know what you'll be bringing.
                </p>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Affordance -->
        <div class="flex items-center gap-2 text-lagavulin-gold/65 transition group-hover:text-lagavulin-gold">
          <span class="label-sm">View</span>
          <svg class="h-4 w-4 sm:h-5 sm:w-5 transition-transform group-hover:translate-x-1"
               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>

      </div>
    </div>
  </div>
<% end %>
