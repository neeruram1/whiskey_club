<section class="space-y-6">
  <div class="flex items-end justify-between gap-4">
    <h2 class="heading-sub text-lagavulin-gold">
      Flight Bottles
    </h2>
    <%= link_to "+ Add bottle",
          new_meeting_bottle_path(meeting),
          class: "link-action",
          data: { turbo_frame: "modal" } %>
  </div>

  <% if bottles.any? %>
    <div class="grid gap-6 md:grid-cols-2">
      <% bottles.each do |bottle| %>
        <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-6 md:p-7 lg:p-8 shadow-lg shadow-black/40 space-y-6">
          
          <!-- Bottle header -->
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 space-y-2">
              <div class="flex items-center gap-2 flex-wrap">
                <p class="label-sm text-lagavulin-gold/80">
                  <%= bottle.distillery.presence || "Distillery" %>
                </p>
                <% unless bottle.rated_by?(current_user) %>
                  <span class="inline-flex items-center rounded-full bg-red-500/20 border border-red-500/40 px-2.5 py-0.5">
                    <p class="label-xs text-red-400 font-semibold">Unrated</p>
                  </span>
                <% end %>
              </div>
              <h3 class="heading-section text-lagavulin-gold leading-tight">
                <%= bottle.name %>
              </h3>
              <p class="body-sm text-lagavulin-gold/85">
                Brought by <%= link_to bottle.user.full_name, user_path(bottle.user), class: "text-lagavulin-gold font-semibold hover:text-lagavulin-gold/80 transition" %>
              </p>
            </div>
            <%= link_to "Edit",
                  edit_bottle_path(bottle),
                  class: "link-action whitespace-nowrap",
                  data: { turbo_frame: "modal" } %>
          </div>

          <!-- Specs grid -->
          <div class="grid gap-3 grid-cols-2">
            <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
              <p class="label-xs text-lagavulin-gold/85">Style</p>
              <p class="mt-2 body-sm text-lagavulin-gold">
                <%= bottle.bottle_type.presence || "—" %>
              </p>
            </div>

            <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
              <p class="label-xs text-lagavulin-gold/85">Age</p>
              <p class="mt-2 body-sm text-lagavulin-gold">
                <%= bottle.age.present? ? pluralize(bottle.age, "year") : "—" %>
              </p>
            </div>

            <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
              <p class="label-xs text-lagavulin-gold/85">Club Avg</p>
              <p class="mt-2 body-sm text-lagavulin-gold">
                <%= bottle.average_rating.presence ? format("%.1f", bottle.average_rating) : "—" %>
                <span class="meta-xs text-lagavulin-gold/55">/ 5</span>
              </p>
            </div>

            <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
              <p class="label-xs text-lagavulin-gold/85">My Rating</p>
              <p class="mt-2 body-sm text-lagavulin-gold">
                <% user_rating = bottle.user_rating(current_user) %>
                <%= user_rating&.score || "—" %>
                <span class="meta-xs text-lagavulin-gold/55">/ 5</span>
              </p>
            </div>
          </div>

          <!-- Divider -->
          <div class="h-px bg-lagavulin-gold/18"></div>

          <!-- Quick rate -->
          <div>
            <% current_rating = bottle.user_rating(current_user) %>
            <%= render "ratings/module", bottle: bottle, current_user_rating: current_rating, show_flavors: false %>
          </div>

          <!-- View full details link -->
          <div class="pt-2">
            <%= link_to "View full details & all ratings →",
                  bottle_url(bottle),
                  class: "body-sm text-lagavulin-gold/80 hover:text-lagavulin-gold transition underline underline-offset-4" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border border-lagavulin-gold/30 bg-black/25 p-8 text-center">
      <p class="body-base text-lagavulin-gold/85">
        No bottles added yet for this flight night.
      </p>
      <p class="mt-2 body-sm text-lagavulin-gold/80">
        Add bottles to start rating!
      </p>
    </div>
  <% end %>
</section>
