<div class="relative min-h-screen bg-[#0f2a23] overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[url('/assets/charredoak.png')] bg-cover bg-center opacity-90"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0f2a23]/60 via-[#0f2a23]/30 to-[#0f2a23]/0"></div>

  <div class="relative z-10 mx-auto w-full max-w-3xl px-6 py-12 md:py-16">
    <header class="mb-8 space-y-2 text-center">
      <h1 class="text-3xl md:text-4xl uppercase tracking-widest text-lagavulin-gold text-shadow-md text-shadow-zinc-950">
        Meeting Details
      </h1>
    </header>
    <div class="rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-6 py-8 md:px-8 md:py-10 shadow-2xl shadow-black/40">
      <div class="space-y-6">
        <div>
          <h2 class="text-xl font-semibold text-lagavulin-green">Date:</h2>
          <p class="mt-1 text-gray-900"><%= @meeting.date.strftime("%B %d, %Y") %></p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-lagavulin-green">Bottle Bringer:</h2>
          <p class="mt-1 text-gray-900"><%= @meeting.bottle_bringer.full_name %></p>
        </div>
      </div>
      <div class="mt-8">
        <%= link_to 'Edit Meeting', edit_meeting_path(@meeting),
              class: "inline-flex items-center justify-center text-xs md:text-sm font-medium tracking-[0.18em] uppercase text-lagavulin-green hover:text-lagavulin-green/80" %>
      </div>
      <div>
        <%= link_to 'Back to Meetings', root_path,
              class: "inline-flex items-center justify-center text-xs md:text-sm font-medium tracking-[0.18em] uppercase text-lagavulin-green hover:text-lagavulin-green/80" %>
    </div>
</div>
