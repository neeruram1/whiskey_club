<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12 md:py-16 space-y-8 sm:space-y-10">
    <%= turbo_frame_tag "modal" %>

    <!-- Header -->
    <header class="space-y-3 sm:space-y-4">
      <div class="flex items-center gap-3">
        <% if @meeting.meeting_status == :upcoming %>
          <span class="rounded-full bg-lagavulin-gold/20 border border-lagavulin-gold/40 px-3 py-1">
            <p class="meta-xs text-lagavulin-gold font-semibold">Upcoming</p>
          </span>
        <% elsif @meeting.meeting_status == :happening_today %>
          <span class="rounded-full bg-lagavulin-gold/30 border border-lagavulin-gold/50 px-3 py-1">
            <p class="meta-xs text-lagavulin-gold font-semibold">Today!</p>
          </span>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
        <h1 class="heading-page text-lagavulin-gold">
          <%= @meeting.date.strftime("%B %-d, %Y") %>
        </h1>
        <%= link_to "Edit tasting",
              edit_meeting_path(@meeting),
              class: "link-mini self-start",
              data: { turbo_frame: "modal" } %>
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <% if @meeting.flight_night? %>
          <p class="body-base text-lagavulin-gold/80">
            <span class="font-semibold text-lagavulin-gold">✈️ Whiskey Flight Night</span> — <%= pluralize(@meeting.bottles.count, 'bottle') %>
          </p>
        <% elsif @meeting.bottle_bringer.present? %>
          <p class="body-base text-lagavulin-gold/80">
            Guided by <%= link_to @meeting.bottle_bringer.full_name, user_path(@meeting.bottle_bringer), class: "font-semibold text-lagavulin-gold hover:text-lagavulin-gold/80 transition" %>
          </p>
        <% end %>
        <% if @attendees.any? %>
          <p class="body-base text-lagavulin-gold/70">
            <%= pluralize(@attendees.count, 'attendee') %>
          </p>
        <% end %>
      </div>
    </header>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Attendance Section -->
    <section class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 sm:p-6 space-y-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="heading-section text-lagavulin-gold">
          Attendance
        </h2>
        <% is_past = @meeting.meeting_status == :past %>
        <%= button_to toggle_attendance_meeting_path(@meeting), 
              method: :post,
              class: "btn-mini #{'bg-lagavulin-gold/20 border-lagavulin-gold/40' if @user_is_attending}" do %>
          <%= @user_is_attending ? (is_past ? "✓ Attended" : "✓ Attending") : (is_past ? "Mark Attended" : "Mark Attending") %>
        <% end %>
      </div>

      <% if @attendees.any? %>
        <div class="flex flex-wrap gap-2">
          <% @attendees.each do |attendee| %>
            <%= link_to user_path(attendee), class: "inline-flex items-center rounded-full bg-lagavulin-gold/15 border border-lagavulin-gold/30 px-3 py-1.5 transition hover:bg-lagavulin-gold/20 hover:border-lagavulin-gold/40" do %>
              <p class="label-sm text-lagavulin-gold">
                <%= attendee.full_name %>
                <% if attendee.id == current_user.id %>
                  <span class="text-lagavulin-gold/60">(You)</span>
                <% end %>
              </p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="body-sm text-lagavulin-gold/60 italic">
          No one marked as attending yet
        </p>
      <% end %>
    </section>

    <% if @meeting.notes.present? %>
      <div class="h-px bg-lagavulin-gold/18"></div>

      <!-- Meeting Notes Section -->
      <section class="rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 sm:p-6 space-y-4">
        <h2 class="heading-section text-lagavulin-gold">
          Meeting Notes
        </h2>
        <div class="prose prose-invert prose-sm max-w-none">
          <p class="body-base text-lagavulin-gold/80 whitespace-pre-wrap"><%= @meeting.notes %></p>
        </div>
      </section>
    <% end %>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Bottle Section -->
    <% 
      meeting_has_passed = @meeting.date < Time.zone.today
      is_revealed = @bottle.present? && @bottle.revealed_at.present?
    %>
    <% if @meeting.flight_night? %>
      <%= render "flight_night_bottles", meeting: @meeting, bottles: @meeting.bottles %>
    <% elsif is_revealed %>
      <!-- Revealed bottle - show full details -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
          <h2 class="heading-sub text-lagavulin-gold">
            Featured Whiskey
          </h2>
          <div class="flex items-center gap-3 flex-wrap">
            <%= link_to "View full details", @bottle, class: "link-mini" %>
            <%= link_to "Edit bottle",
                  edit_bottle_path(@bottle),
                  class: "link-mini",
                  data: { turbo_frame: "modal" } %>
          </div>
        </div>

        <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-4 sm:p-7 md:p-10 shadow-lg shadow-black/40 space-y-6 sm:space-y-8">
          <!-- Bottle details -->
          <div class="space-y-3 sm:space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4">
              <div class="flex-1 min-w-0">
                <p class="label-sm text-lagavulin-gold/80">
                  <%= @bottle.distillery.presence || "Distillery" %>
                </p>

                <h3 class="heading-section text-lagavulin-gold break-words">
                  <%= @bottle.name %>
                </h3>
              </div>

              <div class="flex flex-col items-center gap-1 flex-shrink-0 self-start">
                <%= button_to toggle_wishlist_bottle_path(@bottle), method: :post, class: "group" do %>
                  <% if current_user.wishlist_includes?(@bottle) %>
                    <svg class="w-7 h-7 text-red-500 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Remove from Encore Pours">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                  <% else %>
                    <svg class="w-7 h-7 text-lagavulin-gold/40 group-hover:text-red-500 group-hover:fill-red-500 stroke-current group-hover:scale-110 transition-all" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Add to Encore Pours">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                  <% end %>
                <% end %>
                <p class="label-xs text-lagavulin-gold/60 text-center whitespace-nowrap">
                  <%= current_user.wishlist_includes?(@bottle) ? "Saved" : "Encore?" %>
                </p>
              </div>
            </div>

            <!-- Specs -->
            <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-4">
              <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
                <p class="label-xs text-lagavulin-gold/70">Style</p>
                <p class="mt-2 body-base text-lagavulin-gold">
                  <%= @bottle.bottle_type.presence || "—" %>
                </p>
              </div>

              <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
                <p class="label-xs text-lagavulin-gold/70">Age</p>
                <p class="mt-2 body-base text-lagavulin-gold">
                  <%= @bottle.age.present? ? pluralize(@bottle.age, "year") : "—" %>
                </p>
              </div>

              <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
                <p class="label-xs text-lagavulin-gold/70">Club Average</p>
                <p class="mt-2 body-base text-lagavulin-gold">
                  <%= @bottle.average_rating.presence || "—" %>
                  <span class="meta-xs text-lagavulin-gold/55">/ 5</span>
                </p>
              </div>

              <div class="rounded-2xl border border-lagavulin-gold/14 bg-black/12 p-4">
                <p class="label-xs text-lagavulin-gold/70">My Rating</p>
                <p class="mt-2 body-base text-lagavulin-gold">
                  <%= @current_user_rating&.score || "—" %>
                  <span class="meta-xs text-lagavulin-gold/55">/ 5</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Divider -->
          <div class="h-px bg-lagavulin-gold/18"></div>

          <!-- Rating summary and CTA -->
          <div class="space-y-4">
            <% if @current_user_rating %>
              <div class="rounded-2xl border border-lagavulin-gold/25 bg-lagavulin-gold/5 p-5">
                <div class="flex items-center justify-between mb-3">
                  <p class="label-sm text-lagavulin-gold/80">Your Rating</p>
                  <div class="flex items-center gap-2">
                    <span class="text-2xl font-bold text-lagavulin-gold"><%= @current_user_rating.score %></span>
                    <span class="body-sm text-lagavulin-gold/60">/ 5</span>
                  </div>
                </div>
                <% if @current_user_rating.comment.present? %>
                  <p class="body-sm text-lagavulin-gold/80 italic mb-3">"<%= @current_user_rating.comment %>"</p>
                <% end %>
                <% if @current_user_rating.flavors.present? && @current_user_rating.flavors.any? %>
                  <div class="flex flex-wrap gap-1.5">
                    <% @current_user_rating.flavors.each do |flavor| %>
                      <span class="inline-block rounded-full bg-lagavulin-gold/15 border border-lagavulin-gold/30 px-2.5 py-1">
                        <span class="label-xs text-lagavulin-gold"><%= flavor %></span>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%= link_to @bottle, class: "block group" do %>
              <div class="rounded-2xl border border-lagavulin-gold/30 bg-black/20 p-5 hover:bg-black/30 hover:border-lagavulin-gold/50 transition-all">
                <div class="flex items-center justify-between">
                  <div class="space-y-1">
                    <p class="label-sm text-lagavulin-gold/80">
                      <%= @current_user_rating ? "Update your rating or view all ratings" : "Rate this bottle and see what others think" %>
                    </p>
                    <p class="body-sm text-lagavulin-gold/60">
                      <%= pluralize(@all_ratings.count, 'member rating') %> • Full flavor profiles • Encore Pours
                    </p>
                  </div>
                  <svg class="w-6 h-6 text-lagavulin-gold/60 group-hover:text-lagavulin-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% else %>
      <%= render "bottle_section", meeting: @meeting, bottle: @bottle %>
    <% end %>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Actions -->
    <%= render "actions", meeting: @meeting, bottle: @bottle %>
  </div>
</div>
