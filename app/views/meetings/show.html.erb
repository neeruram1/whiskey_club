<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12 md:py-16 space-y-8 sm:space-y-10">
    <%= turbo_frame_tag "modal" %>

    <!-- Header -->
    <header class="space-y-3 sm:space-y-4">
      <div class="flex items-center gap-3">
        <% if @meeting.meeting_status == :upcoming %>
          <span class="rounded-full bg-lagavulin-gold/20 border border-lagavulin-gold/40 px-3 py-1">
            <p class="meta-xs text-lagavulin-gold font-semibold">Upcoming</p>
          </span>
        <% elsif @meeting.meeting_status == :happening_today %>
          <span class="rounded-full bg-lagavulin-gold/30 border border-lagavulin-gold/50 px-3 py-1">
            <p class="meta-xs text-lagavulin-gold font-semibold">Today!</p>
          </span>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
        <div>
          <p class="label-sm text-lagavulin-gold/85"><%= @meeting.date.strftime("%A") %></p>
          <h1 class="heading-page text-lagavulin-gold uppercase [font-variant-caps:normal]">
            <%= @meeting.date.strftime("%B %-d, %Y") %>
          </h1>
        </div>
        <div class="flex flex-col items-start gap-2 sm:items-end">
          <%= link_to "Edit tasting",
                edit_meeting_path(@meeting),
                class: "link-action",
                data: { turbo_frame: "modal" } %>
          <% if @meeting.meeting_status != :past %>
            <%= render "meetings/add_to_calendar", meeting: @meeting %>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 body-sm text-lagavulin-gold/80">
        <span>
          <% if @meeting.start_time_label.present? %><span class="text-lagavulin-gold/90"><%= @meeting.start_time_label %></span> <span class="text-lagavulin-gold/40">·</span> <% end %>at <span class="text-lagavulin-gold/90"><%= club_location %></span>
        </span>
        <% if @meeting.flight_night? %>
          <span class="text-lagavulin-gold/40" aria-hidden="true">·</span>
          <span><span class="font-semibold text-lagavulin-gold">✈️ Whiskey Flight Night</span> — <%= pluralize(@meeting.bottles.count, 'bottle') %></span>
        <% elsif @meeting.bottle_bringer.present? %>
          <span class="text-lagavulin-gold/40" aria-hidden="true">·</span>
          <span>Guided by <%= link_to @meeting.bottle_bringer.full_name, user_path(@meeting.bottle_bringer), class: "font-semibold text-lagavulin-gold hover:text-lagavulin-gold/80 transition" %></span>
        <% end %>
        <% if @attendees.any? %>
          <span class="text-lagavulin-gold/40" aria-hidden="true">·</span>
          <span><%= pluralize(@attendees.count, 'attendee') %></span>
        <% end %>
      </div>
    </header>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Attendance Section -->
    <section class="card-glow rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-5 sm:p-6 space-y-4 shadow-xl shadow-black/40">
      <% is_past = @meeting.meeting_status == :past %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="heading-section text-lagavulin-gold"><%= is_past ? "Who Came" : "Who's In" %></h2>
          <% if @attendees.any? %>
            <p class="mt-1 meta-xs text-lagavulin-gold/80"><%= @attendees.count %> <%= is_past ? "attended" : "coming" %></p>
          <% end %>
        </div>
        <%= button_to toggle_attendance_meeting_path(@meeting),
              method: :post,
              class: "btn-mini flex-shrink-0 #{'bg-lagavulin-gold/20 border-lagavulin-gold/40' if @user_is_attending}",
              data: { turbo_submits_with: "Saving…" } do %>
          <%= @user_is_attending ? (is_past ? "✓ Attended" : "✓ You're in") : (is_past ? "Mark Attended" : "Count me in") %>
        <% end %>
      </div>

      <% if @attendees.any? %>
        <div class="flex flex-wrap gap-2">
          <% @attendees.each do |attendee| %>
            <%= link_to user_path(attendee),
                  class: "group inline-flex items-center gap-2 rounded-full border border-lagavulin-gold/30 bg-lagavulin-gold/10 py-1 pl-1 pr-3 transition hover:border-lagavulin-gold/50 hover:bg-lagavulin-gold/20" do %>
              <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-lagavulin-gold/50 bg-lagavulin-gold/15 text-[0.65rem] font-bold text-lagavulin-gold" aria-hidden="true">
                <%= attendee.first_name.first %><%= attendee.last_name.first %>
              </span>
              <span class="label-sm text-lagavulin-gold">
                <%= attendee.first_name %><% if attendee.id == current_user.id %> <span class="text-lagavulin-gold/70">(You)</span><% end %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="body-sm italic text-lagavulin-gold/80">
          <%= is_past ? "No one marked as attended." : "Be the first to say you’re in. 🥃" %>
        </p>
      <% end %>

      <% if !is_past && @awaiting_rsvp&.any? %>
        <p class="meta-xs text-lagavulin-gold/60">
          Waiting on <%= @awaiting_rsvp.map(&:first_name).to_sentence %>.
        </p>
      <% end %>
    </section>

    <% if @meeting.notes.present? %>
      <div class="h-px bg-lagavulin-gold/18"></div>

      <!-- Meeting Notes Section -->
      <section class="card-glow rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-5 sm:p-6 space-y-4 shadow-xl shadow-black/40">
        <h2 class="heading-section text-lagavulin-gold">
          Meeting Notes
        </h2>
        <div class="prose prose-invert prose-sm max-w-none">
          <p class="body-base text-lagavulin-gold/80 whitespace-pre-wrap"><%= @meeting.notes %></p>
        </div>
      </section>
    <% end %>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Bottle Section -->
    <% 
      meeting_has_passed = @meeting.date < Time.zone.today
      is_revealed = @bottle.present? && @bottle.revealed?
    %>
    <% if @meeting.flight_night? %>
      <%= render "flight_night_bottles", meeting: @meeting, bottles: @meeting.bottles %>
    <% elsif is_revealed %>
      <!-- Revealed bottle — compact summary; the bottle page owns full specs, ratings & flavors -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
          <h2 class="heading-sub text-lagavulin-gold">
            Featured Whiskey
          </h2>
          <%= link_to "Edit bottle",
                edit_bottle_path(@bottle),
                class: "link-action self-start",
                data: { turbo_frame: "modal" } %>
        </div>

        <div class="card-glow rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-6 sm:p-8 shadow-xl shadow-black/40 space-y-6">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="label-sm uppercase tracking-wider text-lagavulin-gold/80">
                <%= @bottle.distillery.presence || "Distillery" %>
              </p>
              <h3 class="mt-1 text-3xl sm:text-4xl font-bold leading-tight text-lagavulin-gold break-words">
                <%= @bottle.name %>
              </h3>

              <div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3">
                <div>
                  <p class="label-xs text-lagavulin-gold/80">Club Verdict</p>
                  <p class="mt-1 text-xl font-bold text-lagavulin-gold">
                    <%= format_rating(@bottle.average_rating) %><span class="ml-1 font-medium text-lagavulin-gold/70">/ 5</span>
                  </p>
                </div>
                <div>
                  <p class="label-xs text-lagavulin-gold/80">Your Rating</p>
                  <% if @current_user_rating %>
                    <p class="mt-1 text-xl font-semibold text-lagavulin-gold">
                      <%= @current_user_rating.score %><span class="ml-1 font-medium text-lagavulin-gold/70">/ 5</span>
                    </p>
                  <% else %>
                    <p class="mt-1 text-xl font-semibold text-lagavulin-gold/60">Not yet</p>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="flex flex-col items-center gap-1 flex-shrink-0 self-start">
              <%= button_to toggle_wishlist_bottle_path(@bottle), method: :post, class: "group" do %>
                <% if current_user.wishlist_includes?(@bottle) %>
                  <svg class="w-7 h-7 text-red-500 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Remove from Encore Pours">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                <% else %>
                  <svg class="w-7 h-7 text-lagavulin-gold/40 group-hover:text-red-500 group-hover:fill-red-500 stroke-current group-hover:scale-110 transition-all" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Add to Encore Pours">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                <% end %>
              <% end %>
              <p class="label-xs text-lagavulin-gold/80 text-center whitespace-nowrap">
                <%= current_user.wishlist_includes?(@bottle) ? "Saved" : "Encore?" %>
              </p>
            </div>
          </div>

          <!-- Rate on the bottle page (owns the full rating module) -->
          <%= link_to @bottle, class: "block group" do %>
            <div class="flex items-center justify-between rounded-2xl border border-lagavulin-gold/30 bg-black/20 p-4 sm:p-5 transition-all hover:bg-black/30 hover:border-lagavulin-gold/50">
              <div class="space-y-1">
                <p class="label-sm font-semibold text-lagavulin-gold">
                  <%= @current_user_rating ? "Update your rating" : "Rate this bottle" %>
                </p>
                <p class="body-sm text-lagavulin-gold/80">
                  <%= pluralize(@all_ratings.count, 'member rating') %> · flavor profiles · full details
                </p>
              </div>
              <svg class="w-6 h-6 flex-shrink-0 text-lagavulin-gold/85 group-hover:text-lagavulin-gold group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </div>
          <% end %>
        </div>
      </section>
    <% else %>
      <%= render "bottle_section", meeting: @meeting, bottle: @bottle, current_user_rating: @current_user_rating %>
    <% end %>

    <div class="h-px bg-lagavulin-gold/18"></div>

    <!-- Actions -->
    <%= render "actions", meeting: @meeting, bottle: @bottle %>
  </div>
</div>
