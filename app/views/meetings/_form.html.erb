      <%= form_with model: @meeting, data: { controller: "form-errors", turbo_frame: "_top" } do |f| %>
        <div class="space-y-6">
          <div class="flex items-center gap-3 p-4 rounded-xl bg-lagavulin-gold/5 border border-lagavulin-gold/20">
            <%= f.check_box :is_flight, class: "h-5 w-5 rounded border-lagavulin-green/50 text-lagavulin-green focus:ring-lagavulin-green/20" %>
            <%= f.label :is_flight, class: "label-sm text-lagavulin-green" do %>
              ✈️ This is a Whiskey Flight Night <span class="font-normal text-lagavulin-green/70">(multiple bottles from different members)</span>
            <% end %>
          </div>
          
          <div>
            <%= f.label :bottle_bringer_id, class: form_label_classes do %>
              Spirit Guide <span class="font-normal text-lagavulin-green/70">(optional for flight nights)</span>
            <% end %>
            <%= f.select :bottle_bringer_id,
                  @users.map { |user| [user.full_name, user.id] }, 
                  { include_blank: "Select a member" },
                  class: form_input_classes(errors_present: @meeting.errors[:bottle_bringer_id].any?),
                  data: { action: "change->form-errors#clearError", form_errors_error_id_param: "bottle-bringer-error" } %>
            <%= form_error_message(@meeting, :bottle_bringer_id, id: "bottle-bringer-error") %>
          </div>
          
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <%= f.label :date, class: form_label_classes do %>
                Tasting Date
              <% end %>
              <%= f.date_field :date,
                    class: form_input_classes(errors_present: @meeting.errors[:date].any?),
                    data: { action: "change->form-errors#clearError", form_errors_error_id_param: "date-error" } %>
              <%= form_error_message(@meeting, :date, id: "date-error") %>
            </div>

            <div>
              <%= f.label :start_time, class: form_label_classes do %>
                Start Time <span class="font-normal text-lagavulin-green/70">(optional)</span>
              <% end %>
              <%= f.time_field :start_time,
                    class: form_input_classes(errors_present: @meeting.errors[:start_time].any?) %>
            </div>
          </div>
          
          <div>
            <%= f.label :notes, class: form_label_classes do %>
              Meeting Notes <span class="font-normal text-lagavulin-green/70">(optional group discussion notes)</span>
            <% end %>
            <%= f.text_area :notes,
                  rows: 4,
                  placeholder: "Record key discussion points, memorable quotes, or group insights...",
                  class: form_input_classes(errors_present: @meeting.errors[:notes].any?) %>
            <%= form_error_message(@meeting, :notes, id: "notes-error") %>
          </div>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
            <% if @meeting.persisted? %>
              <%= link_to "Cancel", meeting_path(@meeting), 
                    class: form_cancel_button_classes,
                    data: { turbo_frame: "_top" } %>
            <% else %>
              <button type="button" data-action="click->modal#close" class="<%= form_cancel_button_classes %>">Cancel</button>
            <% end %>
            <%= f.submit (@meeting.persisted? ? "Update Tasting" : "Schedule Tasting"), 
                  class: "form-btn order-1 sm:order-2",
                  data: { turbo_submits_with: (@meeting.persisted? ? "Updating..." : "Scheduling...") } %>
          </div>
        </div>
      <% end %>
