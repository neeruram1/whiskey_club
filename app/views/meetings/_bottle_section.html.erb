<% meeting_is_today = meeting.date == Time.zone.today %>
<% meeting_has_passed = meeting.date < Time.zone.today %>
<% meeting_is_upcoming = meeting.date > Time.zone.today %>
<% is_spirit_guide = current_user&.id == meeting.bottle_bringer_id %>
<% is_revealed = bottle.present? && bottle.revealed_at.present? %>

<% if bottle.present? && !is_revealed %>
  <!-- Bottle exists but not revealed yet -->
  <section class="space-y-6">
    <% if is_spirit_guide %>
      <!-- Spirit guide view - can see bottle and reveal it -->
      <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-6 sm:p-8 shadow-lg shadow-black/40 space-y-6">
        <div class="rounded-2xl border border-lagavulin-gold/30 bg-lagavulin-green/5 p-4">
          <p class="body-sm text-lagavulin-gold/80">
            <strong>Spirit Guide View:</strong> Only you can see this bottle until you reveal it.
          </p>
        </div>

        <div class="space-y-3">
          <p class="label-sm text-lagavulin-gold/80">
            <%= bottle.distillery.presence || "Distillery" %>
          </p>
          <h3 class="heading-section text-lagavulin-gold">
            <%= bottle.name %>
          </h3>
          <div class="flex flex-wrap gap-x-5 gap-y-2 meta-sm text-lagavulin-gold/85">
            <span>Style: <span class="text-lagavulin-gold/75"><%= bottle.bottle_type.presence || "—" %></span></span>
            <% if bottle.age.present? %>
              <span>Age: <span class="text-lagavulin-gold/75"><%= pluralize(bottle.age, "year") %></span></span>
            <% end %>
          </div>
          <div class="max-w-2xl mx-auto">
            <%= render "ratings/module", bottle: @bottle, current_user_rating: @current_user_rating %>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <%= link_to "Edit Bottle",
                edit_bottle_path(bottle),
                class: "btn-mini",
                data: { turbo_frame: "modal" } %>
          
          <% if meeting_is_today || meeting_has_passed %>
            <%= button_to "🥃 Reveal Bottle to Everyone",
                  reveal_bottle_path(bottle),
                  method: :post,
                  class: "btn-mini bg-lagavulin-gold/20 border-lagavulin-gold/40",
                  data: { turbo: false } %>
          <% else %>
            <p class="body-sm text-lagavulin-gold/80 self-center">
              You can reveal the bottle on <%= meeting.date.strftime("%B %-d") %>
            </p>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Non-spirit guide view - bottle is hidden -->
      <%= render "meetings/sealed_bottle", meeting: meeting %>

      <% if meeting_is_today || meeting_has_passed %>
        <div class="max-w-2xl mx-auto">
          <%= render "ratings/module", bottle: @bottle, current_user_rating: @current_user_rating %>
        </div>
      <% end %>
    <% end %>
  </section>

<% else %>
  <!-- No bottle exists yet -->
  <section class="space-y-6">
    <% if meeting_is_today && is_spirit_guide %>
      <!-- It's meeting day and you're the spirit guide -->
      <div class="rounded-3xl border-2 border-lagavulin-gold/40 bg-lagavulin-gold/5 p-8 shadow-xl shadow-black/50 text-center space-y-4">
        <div class="space-y-2">
          <p class="heading-sub text-lagavulin-gold">
            🥃 Time to Reveal
          </p>
          <p class="body-base text-lagavulin-gold/80">
            Add the bottle details so everyone can see and rate it!
          </p>
        </div>
        
        <%= link_to new_meeting_bottle_path(meeting),
              class: "inline-flex items-center justify-center gap-2 rounded-full border-2 border-lagavulin-gold bg-lagavulin-gold/15 px-8 py-4 text-base font-bold tracking-widest uppercase text-lagavulin-gold shadow-lg shadow-black/40 transition hover:bg-lagavulin-gold/25 hover:scale-105 active:scale-100",
              data: { turbo_frame: "modal" } do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          <span>Add Bottle</span>
        <% end %>
      </div>
      
    <% elsif meeting_is_today %>
      <!-- It's meeting day but you're not the spirit guide, and no bottle yet -->
      <%= render "meetings/sealed_bottle", meeting: meeting, awaiting_bottle: true %>

    <% elsif meeting_has_passed %>
      <!-- Meeting completed but no bottle added -->
      <div class="rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-8 shadow-lg shadow-black/40 space-y-4">
        <div class="space-y-2">
          <p class="heading-section text-lagavulin-gold/85">
            Meeting Completed
          </p>
          <p class="body-base text-lagavulin-gold/80">
            This tasting has passed. Add the bottle details to complete the record.
          </p>
        </div>
        
        <%= link_to "Add Bottle Details",
              new_meeting_bottle_path(meeting),
              class: "btn-mini w-full sm:w-auto",
              data: { turbo_frame: "modal" } %>
      </div>
      
    <% elsif meeting_is_upcoming && is_spirit_guide %>
      <!-- Upcoming meeting - spirit guide can add bottle early -->
      <div class="rounded-3xl border border-lagavulin-gold/30 bg-black/25 p-8 shadow-lg shadow-black/40 space-y-4">
        <div class="space-y-2">
          <p class="heading-section text-lagavulin-gold">
            Add Your Bottle
          </p>
          <p class="body-sm text-lagavulin-gold/85">
            Add the bottle details now (it will stay hidden until you reveal it on <%= meeting.date.strftime("%B %-d") %>)
          </p>
        </div>
        
        <%= link_to "Add Bottle",
              new_meeting_bottle_path(meeting),
              class: "btn-mini w-full sm:w-auto",
              data: { turbo_frame: "modal" } %>
      </div>
      
    <% else %>
      <!-- Upcoming meeting - non-spirit guide -->
      <%= render "meetings/sealed_bottle", meeting: meeting %>
    <% end %>
  </section>
<% end %>
