<div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <div class="mx-auto max-w-4xl">
    
    <!-- Header -->
    <div class="mb-8">
      <h1 class="heading-hero text-lagavulin-gold mb-3">
        Tasting Archive
      </h1>
      <p class="body-base text-lagavulin-gold/70">
        A complete chronological record of every whiskey tasting night
      </p>
    </div>

    <!-- Filter UI -->
    <div data-controller="meeting-filter" class="space-y-6">
      
      <!-- Count & Search -->
      <div class="space-y-4">
        <p class="body-sm text-lagavulin-gold/75">
          <span data-meeting-filter-target="count"><%= @meetings.count %></span> meetings shown
        </p>

        <input
          type="search"
          placeholder="Search bottle name, distillery, or spirit guide…"
          data-meeting-filter-target="query"
          data-action="input->meeting-filter#filter"
          class="w-full rounded-xl border border-lagavulin-gold/25 bg-black/20
                 px-4 py-3 text-base text-lagavulin-gold placeholder:text-lagavulin-gold/40
                 focus:outline-none focus:ring-4 focus:ring-lagavulin-gold/15 focus:border-lagavulin-gold/50"
        />
      </div>

      <!-- Filters & Sort -->
      <div class="flex flex-wrap gap-3 md:gap-4">
        <!-- Status filter -->
        <select
          data-meeting-filter-target="status"
          data-action="change->meeting-filter#filter"
          class="rounded-lg border border-lagavulin-gold/30 bg-black/25 px-3 py-2
                 text-sm text-lagavulin-gold
                 focus:outline-none focus:ring-2 focus:ring-lagavulin-gold/30"
        >
          <option value="">All Status</option>
          <option value="past">Past Tastings</option>
          <option value="upcoming">Upcoming</option>
          <option value="has_bottle">With Bottle</option>
          <option value="no_bottle">No Bottle Yet</option>
          <option value="unrated">Unrated by Me</option>
        </select>

        <!-- Year filter -->
        <select
          data-meeting-filter-target="year"
          data-action="change->meeting-filter#filter"
          class="rounded-lg border border-lagavulin-gold/30 bg-black/25 px-3 py-2
                 text-sm text-lagavulin-gold
                 focus:outline-none focus:ring-2 focus:ring-lagavulin-gold/30"
        >
          <option value="">All Years</option>
          <% @meetings.map { |m| m.date.year }.uniq.sort.reverse.each do |year| %>
            <option value="<%= year %>"><%= year %></option>
          <% end %>
        </select>

        <!-- Sort buttons -->
        <button
          type="button"
          data-meeting-filter-target="sortButton"
          data-sort-value="date_desc"
          data-action="click->meeting-filter#sort"
          class="rounded-lg border px-4 py-2.5 text-sm font-medium transition-all"
        >
          Newest First
        </button>

        <button
          type="button"
          data-meeting-filter-target="sortButton"
          data-sort-value="date_asc"
          data-action="click->meeting-filter#sort"
          class="rounded-lg border px-4 py-2.5 text-sm font-medium transition-all"
        >
          Oldest First
        </button>
      </div>

      <!-- Active filter chips -->
      <div
        data-meeting-filter-target="chipsRow"
        class="hidden flex flex-wrap items-center gap-2"
      >
        <p class="meta-xs text-lagavulin-gold/60">Active filters:</p>

        <button
          type="button"
          data-meeting-filter-target="chipStatus"
          data-filter-key="status"
          data-action="click->meeting-filter#clearOne"
          class="hidden inline-flex items-center gap-2 rounded-full bg-lagavulin-gold/15
                 border border-lagavulin-gold/40 px-3 py-1 label-xs text-lagavulin-gold
                 hover:bg-lagavulin-gold/25 transition"
        >
          <span data-meeting-filter-target="chipStatusText"></span>
          <span class="text-lagavulin-gold/50">×</span>
        </button>

        <button
          type="button"
          data-meeting-filter-target="chipYear"
          data-filter-key="year"
          data-action="click->meeting-filter#clearOne"
          class="hidden inline-flex items-center gap-2 rounded-full bg-lagavulin-gold/15
                 border border-lagavulin-gold/40 px-3 py-1 label-xs text-lagavulin-gold
                 hover:bg-lagavulin-gold/25 transition"
        >
          <span data-meeting-filter-target="chipYearText"></span>
          <span class="text-lagavulin-gold/50">×</span>
        </button>

        <button
          type="button"
          data-meeting-filter-target="clearAll"
          data-action="click->meeting-filter#clearAll"
          class="ml-1 label-xs text-lagavulin-gold/60
                 hover:text-lagavulin-gold transition"
        >
          Clear all
        </button>
      </div>

      <!-- Timeline -->
      <ul data-meeting-filter-target="list" class="space-y-6 list-none">
        <% @meetings.each do |meeting| %>
          <% bottle = meeting.primary_bottle %>
          <% has_unrated_bottles = meeting.date < Time.zone.today && meeting.bottles.any? { |b| !@user_ratings[b.id] } %>
          <% search_terms = meeting.bottles.map { |b| "#{b.name} #{b.distillery}" }.join(' ') %>
          <li
            data-meeting-filter-target="item"
            data-bottle-name="<%= search_terms %>"
            data-distillery="<%= meeting.bottles.map(&:distillery).join(' ') %>"
            data-spirit-guide="<%= meeting.bottle_bringer&.full_name || meeting.bottles.map { |b| b.user.full_name }.join(' ') %>"
            data-year="<%= meeting.date.year %>"
            data-date="<%= meeting.date.to_time.to_i %>"
            data-has-bottle="<%= meeting.bottles.any? %>"
            data-is-past="<%= meeting.date <= Time.zone.today %>"
            data-unrated="<%= has_unrated_bottles %>"
          >
            <%= link_to meeting_path(meeting), 
                  class: "block group transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.99]" do %>
              
              <div class="relative overflow-hidden rounded-2xl border border-lagavulin-gold/30 bg-black/25 p-5 sm:p-6 md:p-8
                          shadow-lg shadow-black/40 
                          group-hover:border-lagavulin-gold/50 group-hover:bg-black/35 
                          group-hover:shadow-xl group-hover:shadow-black/50">
            
            <!-- Content -->
            <div class="grid gap-6 sm:grid-cols-[1fr,auto]">
              
              <!-- Left: Meeting info -->
              <div class="space-y-3">
                <!-- Date & Status -->
                <div class="flex items-center gap-3 flex-wrap">
                  <h2 class="text-xl sm:text-2xl font-bold text-lagavulin-gold">
                    <%= meeting.date.strftime("%B %d, %Y") %>
                  </h2>
                  <% if meeting.date > Time.zone.today %>
                    <span class="inline-flex items-center rounded-full bg-lagavulin-gold/10 border border-lagavulin-gold/40 px-3 py-1">
                      <p class="label-xs text-lagavulin-gold font-semibold">Upcoming</p>
                    </span>
                  <% end %>
                  <% is_attending = current_user && meeting.attendees.exists?(id: current_user.id) %>
                  <% if is_attending %>
                    <% attendance_label = meeting.date < Time.zone.today ? "Attended" : "Attending" %>
                    <span class="inline-flex items-center rounded-full bg-lagavulin-gold/10 border border-lagavulin-gold/30 px-3 py-1">
                      <p class="label-xs text-lagavulin-gold/90 font-medium"><%= attendance_label %></p>
                    </span>
                  <% end %>
                  <% if has_unrated_bottles %>
                    <span class="inline-flex items-center rounded-full bg-red-500/20 border border-red-500/40 px-3 py-1">
                      <p class="label-xs text-red-400 font-semibold">
                        <% if meeting.flight_night? %>
                          <%= pluralize(meeting.bottles.count { |b| !@user_ratings[b.id] }, 'Unrated') %>
                        <% else %>
                          Unrated
                        <% end %>
                      </p>
                    </span>
                  <% end %>
                </div>

                <!-- Spirit Guide or Flight Info -->
                <% if meeting.flight_night? %>
                  <p class="body-sm text-lagavulin-gold/70">
                    ✈️ <span class="text-lagavulin-gold font-semibold">Whiskey Flight Night</span> — <%= pluralize(meeting.bottles.count, 'bottle') %>
                  </p>
                <% elsif meeting.bottle_bringer.present? %>
                  <p class="body-sm text-lagavulin-gold/70">
                    Guided by <span class="text-lagavulin-gold font-semibold"><%= meeting.bottle_bringer.full_name %></span>
                  </p>
                <% end %>

                <!-- Bottles or placeholder -->
                <% if meeting.flight_night? && meeting.bottles.any? %>
                  <div class="mt-4 space-y-2">
                    <% meeting.bottles.each do |flight_bottle| %>
                      <div class="rounded-xl bg-black/30 border border-lagavulin-gold/20 p-3 sm:p-4">
                        <div class="flex items-start justify-between gap-3">
                          <div class="flex-1">
                            <p class="label-xs text-lagavulin-gold/60 uppercase tracking-wider">
                              <%= flight_bottle.distillery %> · <span class="text-lagavulin-gold/50"><%= flight_bottle.user.full_name %></span>
                            </p>
                            <h4 class="text-base font-bold text-lagavulin-gold mt-1">
                              <%= flight_bottle.name %>
                            </h4>
                          </div>
                          <% if flight_bottle.ratings.any? %>
                            <div class="flex items-center gap-1.5 bg-lagavulin-gold/10 rounded-lg px-2 py-1">
                              <svg class="h-3.5 w-3.5 text-lagavulin-gold" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                              </svg>
                              <span class="text-xs font-semibold text-lagavulin-gold">
                                <%= flight_bottle.ratings.average(:score)&.round(1) || 'N/A' %>
                              </span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% elsif bottle.present? %>
                  <div class="mt-4 rounded-xl bg-black/30 border border-lagavulin-gold/20 p-4">
                    <p class="label-xs text-lagavulin-gold/60 uppercase tracking-wider mb-2">
                      <%= bottle.distillery %>
                    </p>
                    <h3 class="text-xl font-bold text-lagavulin-gold mb-3">
                      <%= bottle.name %>
                    </h3>
                    
                    <div class="flex items-center gap-4 text-sm">
                      <% if bottle.ratings.any? %>
                        <div class="flex items-center gap-1.5">
                          <svg class="h-4 w-4 text-lagavulin-gold" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                          <span class="font-semibold text-lagavulin-gold">
                            <%= bottle.ratings.average(:score)&.round(1) || 'N/A' %>
                          </span>
                          <span class="text-lagavulin-gold/60">
                            (<%= bottle.ratings.count %> <%= 'rating'.pluralize(bottle.ratings.count) %>)
                          </span>
                        </div>
                      <% else %>
                        <span class="text-lagavulin-gold/50 italic">Not yet rated</span>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <% is_spirit_guide = current_user&.id == meeting.bottle_bringer_id %>
                  <% meeting_is_upcoming = meeting.date > Time.zone.today %>
                  <div class="mt-4 rounded-xl border-2 border-dashed border-lagavulin-gold/20 bg-black/20 p-6 text-center">
                    <svg class="mx-auto h-10 w-10 text-lagavulin-gold/30 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <% if meeting_is_upcoming && is_spirit_guide %>
                      <p class="text-sm font-semibold text-lagavulin-gold/60">
                        🔒 Bottle not added yet
                      </p>
                      <p class="mt-1 text-xs text-lagavulin-gold/40">
                        Click to add (will stay hidden until you reveal it)
                      </p>
                    <% elsif meeting_is_upcoming %>
                      <p class="text-sm font-semibold text-lagavulin-gold/60">
                        🔒 Bottle not yet revealed
                      </p>
                      <p class="mt-1 text-xs text-lagavulin-gold/40">
                        The spirit guide will reveal it during the tasting
                      </p>
                    <% else %>
                      <p class="text-sm font-semibold text-lagavulin-gold/60">
                        No bottle added yet
                      </p>
                      <p class="mt-1 text-xs text-lagavulin-gold/40">
                        Click to add bottle details
                      </p>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Right: Action arrow -->
              <div class="flex items-center justify-end sm:justify-center">
                <svg class="h-6 w-6 text-lagavulin-gold/40 transition-all group-hover:text-lagavulin-gold group-hover:translate-x-1"
                     fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>

                </div>
              </div>

            <% end %>
          </li>
        <% end %>
      </ul>

      <!-- Empty state (filter results) -->
      <div
        data-meeting-filter-target="empty"
        class="hidden rounded-2xl border border-lagavulin-gold/20 bg-black/20 p-16 text-center"
      >
        <div class="mx-auto max-w-md space-y-4">
          <svg class="mx-auto h-16 w-16 text-lagavulin-gold/30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
          </svg>
          <div>
            <p class="text-2xl font-bold text-lagavulin-gold/70">
              No meetings found
            </p>
            <p class="mt-2 body-sm text-lagavulin-gold/50">
              Try adjusting your search or filter criteria
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Empty state (no meetings exist) -->
    <% if @meetings.empty? %>
      <div class="rounded-2xl border border-lagavulin-gold/20 bg-black/20 p-16 text-center">
        <div class="mx-auto max-w-md space-y-4">
          <svg class="mx-auto h-16 w-16 text-lagavulin-gold/30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
          </svg>
          <div>
            <p class="text-2xl font-bold text-lagavulin-gold/70">
              No tastings yet
            </p>
            <p class="mt-2 body-sm text-lagavulin-gold/50">
              Schedule your first tasting night to get started
            </p>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>
