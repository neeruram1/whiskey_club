<div class="mx-auto w-full max-w-screen-xl px-6 py-12 md:py-16">
  <div class="mb-4 text-xl/10 uppercase tracking-widest text-shadow-md text-shadow-zinc-950 text-lagavulin-gold"> 
    <h1>New Meeting</h1>
  </div>
  <div class="rounded-2xl border-4 border-lagavulin-gold ring-4 ring-lagavulin-green-light ring-offset-4 ring-offset-[#F8F5E9] bg-[#F8F5E9] p-6 shadow-xl">
    <% if @meeting.errors.any? %>
      <div class="mb-4 rounded-lg border border-yellow-300 bg-yellow-50 px-4 py-3 text-sm text-yellow-900">
        <%= @meeting.errors.full_messages.join(", ") %>
      </div>
    <% end %>
    
    
    <%= form_with model: @meeting, local: true do |f| %>
      <div class="space-y-6">
        <%# Bottle Bringer %>
        <div>
          <div class="mb-2 flex items-baseline justify-between">
            <%= f.label :bottle_bringer_id, class: "text-lg tracking-widest text-shadow-sm uppercase text-shadow-lagavulin-green-light text-lagavulin-green" %>
          </div>
          <%= f.select :bottle_bringer_id,
                User.all.collect { |u| [u.full_name, u.id] }, { include_blank: true },
                class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-300 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/15" %>
        </div>
        <%# Date %>
        <div>
          <div class="mb-2 flex items-baseline justify-between">
            <%= f.label :date, class: "text-lg tracking-widest text-shadow-sm uppercase text-shadow-lagavulin-green-light text-lagavulin-green" %>
          </div>
          <%= f.date_field :date,
                class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-300 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/15" %>
        </div>

        <%# Submit %>
        <div class="pt-1 text-center">
          <%= f.submit "Schedule Meeting",
                class: "inline-flex w-1/2 items-center justify-center rounded-4xl border-1 border-lagavulin-green bg-lagavulin-green px-4 py-3 text-sm tracking-widest text-shadow-sm uppercase font-semibold text-lagavulin-gold transition-colors duration-200 hover:bg-lagavulin-green-light hover:text-lagavulin-green focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lagavulin-gold/30 disabled:cursor-not-allowed disabled:opacity-50" %>
        </div>
      </div>

      <span class="ml-auto text-sm tracking-widest text-shadow-sm text-shadow-zinc-950 text-lagavulin-gold">
        <%= link_to 'Back', root_path, 
            class: "inline-flex items-center justify-center rounded-4xl border-1 border-lagavulin-green bg-lagavulin-green px-4 py-2 text-sm tracking-widest text-shadow-sm uppercase font-semibold text-lagavulin-gold transition-colors duration-200 hover:bg-lagavulin-green-light hover:text-lagavulin-green focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lagavulin-gold/30 disabled:cursor-not-allowed disabled:opacity-50"
        %>
      </span>
    <% end %>
  </div>
</div>
