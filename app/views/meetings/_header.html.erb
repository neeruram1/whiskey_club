<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="text-[0.7rem] tracking-[0.32em] uppercase text-lagavulin-gold/70">
    Tasting night
  </div>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <%= link_to root_path,
      class: "inline-flex items-center gap-2 text-xs tracking-[0.3em] uppercase
              text-[#E8D6A7]/70 hover:text-lagavulin-gold transition" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Home
    <% end %>
    <%= link_to archives_path, class: "link-mini inline-flex items-center gap-2" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      Archive
    <% end %>
  </div>
</div>

<header class="max-w-3xl space-y-3">
  <h1 class="text-[#E8D6A7] text-2xl sm:text-2xl md:text-2xl font-semibold small-caps tracking-wide leading-tight">
    <%= meeting.date.strftime("%B %d, %Y") %>
  </h1>

  <p class="text-[#E8D6A7]/55 text-[0.7rem] sm:text-xs tracking-[0.32em] uppercase">
    Bottle master:
    <span class="text-[#E8D6A7]/80 tracking-widest normal-case sm:uppercase sm:tracking-[0.22em]">
      <%= meeting.bottle_bringer.full_name %>
    </span>
  </p>
</header>

