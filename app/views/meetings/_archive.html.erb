
<div data-controller="meeting-filter" class="space-y-6">
  <div class="space-y-2">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="mt-1 meta-sm text-lagavulin-gold/75">
          <span data-meeting-filter-target="count"><%= meetings.count %></span> tasting nights shown
        </p>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <!-- Search -->
      <div class="w-full sm:w-[18rem]">
        <input
          type="search"
          placeholder="Search spirit guide…"
          data-meeting-filter-target="query"
          data-action="input->meeting-filter#filter"
          class="w-full rounded-xl border border-lagavulin-gold/25 bg-black/20
                 px-4 py-3 min-h-[44px] text-sm text-lagavulin-gold placeholder:text-lagavulin-gold/40
                 focus:outline-none focus:ring-4 focus:ring-lagavulin-gold/15 focus:border-lagavulin-gold/50 touch-manipulation"
        />
      </div>

      <!-- Year -->
      <div class="flex items-center gap-3">
        <p class="label-sm text-lagavulin-gold/70">Year</p>
        <select
          data-meeting-filter-target="year"
          data-action="change->meeting-filter#filter"
          class="bg-transparent border-b-2 border-lagavulin-gold/40 min-h-[44px] px-3 py-2
                 label-sm text-lagavulin-gold touch-manipulation
                 focus:outline-none focus:border-lagavulin-gold"
        >
          <option value="">All</option>
          <% meetings.map { |m| m.date.year }.uniq.sort.reverse.each do |y| %>
            <option value="<%= y %>"><%= y %></option>
          <% end %>
        </select>

        <button
          type="button"
          data-action="click->meeting-filter#clearAll"
          data-meeting-filter-target="clearAll"
          class="hidden ml-2 px-3 py-2 min-h-[44px] label-xs text-lagavulin-gold/60
                 hover:text-lagavulin-gold transition touch-manipulation"
        >
          Clear
        </button>
      </div>
    </div>

    <div class="h-px bg-lagavulin-gold/20"></div>
  </div>

  <!-- List -->
  <ul data-meeting-filter-target="list" class="space-y-4 pl-2 sm:pl-4">
    <% meetings.each do |meeting| %>
      <li
        data-meeting-filter-target="item"
        data-date="<%= meeting.date.to_time.to_i %>"
        data-year="<%= meeting.date.year %>"
        data-spirit-guide="<%= meeting.bottle_bringer&.full_name.to_s %>"
        class="relative"
      >
        <%= link_to meeting_path(meeting), class: "block group touch-manipulation" do %>
          <div class="flex min-h-[100px]">
            <div class="w-[3px] bg-lagavulin-gold/40 rounded-full transition group-hover:bg-lagavulin-gold"></div>

            <div class="flex-1 ml-4 rounded-xl bg-black/20 px-4 py-4 sm:px-5
                        shadow-sm shadow-black/40 transition group-hover:bg-black/30
                        group-active:scale-[0.98]">
              <div class="space-y-1">
                <p class="heading-card text-lagavulin-gold">
                  <%= date_with_friendly(meeting.date) %>
                </p>

                <p class="meta-sm text-lagavulin-gold/70">
                  This month’s selection by
                  <span class="text-[#E8D6A7]/90"><%= meeting.bottle_bringer&.full_name || "—" %></span>
                </p>
                <p class="text-[#E8D6A7]/55 text-xs sm:text-sm tracking-widest">
                  <% if meeting.bottle.present? %>
                    Featured bottle:
                    <span class="text-[#E8D6A7]/80 tracking-widest normal-case sm:uppercase sm:tracking-widest">
                      <%= meeting.bottle.name %> (<%= meeting.bottle.distillery %>)
                    </span>
                  <% else %>
                    No bottle added yet
                  <% end %>
              </div>
            </div>

            <div class="ml-4 flex items-center text-lagavulin-gold/60 transition group-hover:text-lagavulin-gold">
              <svg class="h-5 w-5 transition-transform group-hover:translate-x-1"
                   fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>

  <!-- Empty state -->
  <div
    data-meeting-filter-target="empty"
    class="hidden pt-10 text-center space-y-3"
  >
    <svg class="mx-auto h-12 w-12 text-lagavulin-gold/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <p class="text-sm tracking-widest text-[#E8D6A7]/75">
      No tasting nights match your search
    </p>
    <p class="text-[0.7rem] tracking-[0.32em] uppercase text-[#E8D6A7]/45">
      Try adjusting your filters or search terms
    </p>
  </div>
</div>
