<section class="mt-8">
  <div class="flex flex-col gap-3 sm:gap-4 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
      <%= link_to "Edit Meeting",
            edit_meeting_path(meeting),
            class: "text-xs sm:text-sm md:text-base uppercase tracking-wide text-lagavulin-gold/80 hover:text-lagavulin-gold" %>

      <% if meeting.bottle.blank? && meeting.meeting_status != :upcoming %>
        <%= link_to "Add Bottle",
              new_meeting_bottle_path(meeting),
              class: "text-xs sm:text-sm md:text-base uppercase tracking-wide text-lagavulin-gold/80 hover:text-lagavulin-gold" %>
      <% end %>
    </div>

    <%= link_to "Delete Meeting",
          meeting_path(meeting),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "text-xs sm:text-sm md:text-base uppercase tracking-wide text-lagavulin-gold/60 hover:text-lagavulin-gold" %>
  </div>
</section>

