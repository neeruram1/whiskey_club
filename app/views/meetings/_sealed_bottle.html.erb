<%# The pre-reveal "mystery bottle" moment for members. locals: meeting,
    awaiting_bottle: false — true on tasting day when the guide hasn't added the
    bottle yet, so the empty state reads as "not loaded in" rather than broken. %>
<% awaiting_bottle = local_assigns.fetch(:awaiting_bottle, false) %>
<% days_until = (meeting.date.to_date - Time.zone.today).to_i %>
<% when_revealed = days_until <= 0 ? "today" : (days_until == 1 ? "tomorrow" : "in #{days_until} days") %>
<% guide = meeting.bottle_bringer %>

<div class="relative overflow-hidden rounded-3xl border border-lagavulin-gold/40 bg-black/40 p-8 sm:p-12 text-center shadow-lg shadow-black/40">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(201,169,104,0.18),transparent_70%)]"></div>

  <div class="relative space-y-4">
    <!-- Wax seal -->
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full border-2 border-lagavulin-gold/50 bg-lagavulin-gold/10 shadow-lg shadow-black/40 motion-safe:animate-pulse">
      <span class="text-3xl" aria-hidden="true">&#128274;</span>
    </div>

    <% if awaiting_bottle %>
      <p class="label-sm text-lagavulin-gold/85">Waiting on the pour</p>
      <p class="heading-sub text-lagavulin-gold">Today&rsquo;s dram isn&rsquo;t in yet</p>

      <p class="body-base text-lagavulin-gold/85 max-w-md mx-auto">
        <% if guide.present? %>
          <span class="font-semibold text-lagavulin-gold"><%= guide.full_name %></span> hasn&rsquo;t loaded tonight&rsquo;s bottle in yet.
          Rating opens the moment they do.
        <% else %>
          The bottle hasn&rsquo;t been loaded in yet. Rating opens the moment it is.
        <% end %>
        &#129346;
      </p>
    <% else %>
      <p class="label-sm text-lagavulin-gold/85">Sealed until the reveal</p>
      <p class="heading-sub text-lagavulin-gold">The bottle is a mystery</p>

      <p class="body-base text-lagavulin-gold/85 max-w-md mx-auto">
        <% if guide.present? %>
          <span class="font-semibold text-lagavulin-gold"><%= guide.full_name %></span> pours the reveal <%= when_revealed %>.
        <% else %>
          The reveal comes <%= when_revealed %>.
        <% end %>
        No peeking till the pour. &#129346;
      </p>
    <% end %>

    <% if guide.present? %>
      <% avg = guide.pours_average_score %>
      <div class="mt-2 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 meta-xs text-lagavulin-gold/70">
        <% if avg.present? %>
          <span>Their pours average <span class="font-semibold text-lagavulin-gold/90"><%= format_rating(avg) %></span> / 5</span>
          <span class="text-lagavulin-gold/40" aria-hidden="true">·</span>
        <% end %>
        <span><%= guide.times_guiding.ordinalize %> time as spirit guide</span>
      </div>
    <% end %>
  </div>
</div>
