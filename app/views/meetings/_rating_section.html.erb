<section class="mt-4 space-y-4">
  <% if @user_rating.present? %>
    <p>
      <span class="uppercase text-xs sm:text-sm tracking-[0.24em] text-lagavulin-gold/80 mr-1">
        Your Rating
      </span>
      <span class="text-base sm:text-lg text-[#E8D6A7]">
        <%= @user_rating %> / 10
      </span>
    </p>
  <% else %>
    <p class="text-xs sm:text-sm tracking-[0.22em] text-[#E8D6A7]/80 uppercase">
      You have not rated this bottle yet.
    </p>
  <% end %>

  <div class="space-y-2">
    <%= form_with url: ratings_path,
                  method: :post,
                  local: true,
                  class: "flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4" do %>

      <%= hidden_field_tag "rating[bottle_id]", bottle.id %>

      <%= number_field_tag "rating[score]",
          @user_rating,
          in: 1..10,
          step: 0.1,
          required: true,
          class: "w-24 rounded border border-lagavulin-gold/50 bg-[#0b201b]/70 px-3 py-2 text-base sm:text-lg text-[#E8D6A7] placeholder-lagavulin-gold/40 focus:border-lagavulin-gold focus:outline-none focus:ring-1 focus:ring-lagavulin-gold" %>

      <%= submit_tag(
            @user_rating.present? ? "Update Rating" : "Add Rating",
            class: "btn-sm"
          ) %>
    <% end %>
  </div>
</section>
