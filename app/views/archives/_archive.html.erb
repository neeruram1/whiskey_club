<div data-controller="archive-toggle" class="space-y-8">

  <!-- Header + Toggle -->
  <div class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl uppercase tracking-[0.22em] sm:tracking-[0.28em] text-lagavulin-gold">
        Archive
      </h2>
        <p class="mt-1 text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/60">
          Browse bottles and tasting nights
        </p>
      </div>

      <!-- Toggle -->
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm tracking-widest uppercase">
        <button
          type="button"
          data-archive-toggle-target="tab"
          data-view="bottles"
          data-action="click->archive-toggle#switch"
          class="border-b border-transparent pb-1 uppercase text-[#E8D6A7]/70 hover:text-lagavulin-gold hover:border-lagavulin-gold/40 transition"
        >
          Bottles
        </button>

        <button
          type="button"
          data-archive-toggle-target="tab"
          data-view="meetings"
          data-action="click->archive-toggle#switch"
          class="border-b border-transparent pb-1 uppercase text-[#E8D6A7]/70 hover:text-lagavulin-gold hover:border-lagavulin-gold/40 transition"
        >
          Tasting Nights
        </button>
      </div>
    </div>
    <div class="h-px bg-lagavulin-gold/25"></div>
  </div>

  <!-- Bottles panel -->
  <section data-archive-toggle-target="panel" data-view="bottles">
    <%# ===========================
        Your existing Bottle Archive
        (the one that uses bottle-filter)
        =========================== %>

    <%= render partial: "bottles/archive", locals: { bottles: bottles } %>
  </section>

  <!-- Meetings panel -->
  <section data-archive-toggle-target="panel" data-view="meetings" class="hidden">
    <%= render "meetings/archive", meetings: meetings %>
  </section>
</div>
