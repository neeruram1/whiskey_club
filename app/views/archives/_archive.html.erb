<div data-controller="archive-toggle" class="space-y-8">

  <!-- Header + Toggle -->
  <div class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mt-1 meta-sm text-lagavulin-gold/75">
          Browse bottles and tasting nights
        </p>
      </div>

      <!-- Toggle -->
      <div class="flex flex-wrap gap-x-2 gap-y-2">
        <button
          type="button"
          data-archive-toggle-target="tab"
          data-view="bottles"
          data-action="click->archive-toggle#switch"
          class="border-b-2 border-transparent px-4 py-2 min-h-[44px] label-sm text-lagavulin-gold/70 hover:text-lagavulin-gold hover:border-lagavulin-gold/40 transition touch-manipulation rounded-t-lg"
        >
          Browse Bottles
        </button>

        <button
          type="button"
          data-archive-toggle-target="tab"
          data-view="meetings"
          data-action="click->archive-toggle#switch"
          class="border-b-2 border-transparent px-4 py-2 min-h-[44px] label-sm text-lagavulin-gold/70 hover:text-lagavulin-gold hover:border-lagavulin-gold/40 transition touch-manipulation rounded-t-lg"
        >
          Browse Tastings
        </button>
      </div>
    </div>
    <div class="h-px bg-lagavulin-gold/25"></div>
  </div>

  <!-- Bottles panel -->
  <section data-archive-toggle-target="panel" data-view="bottles">
    <%# ===========================
        Your existing Bottle Archive
        (the one that uses bottle-filter)
        =========================== %>

    <%= render partial: "bottles/archive", locals: { bottles: bottles } %>
  </section>

  <!-- Meetings panel -->
  <section data-archive-toggle-target="panel" data-view="meetings" class="hidden">
    <%= render "meetings/archive", meetings: meetings %>
  </section>
</div>
