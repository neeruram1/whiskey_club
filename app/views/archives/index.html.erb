<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:py-12 md:py-16 space-y-8">
    <%= turbo_frame_tag "modal" %>

    <!-- Header -->
    <header class="space-y-2">
      <h1 class="heading-page text-lagavulin-gold">
        Bottle Archive
      </h1>
      <p class="body-base text-lagavulin-gold/80">
        Browse all past tastings and bottles
      </p>
    </header>

    <%= render partial: "bottles/archive", locals: { bottles: @bottles } %>
  </div>
</div>

