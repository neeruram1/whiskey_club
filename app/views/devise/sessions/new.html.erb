<div class="relative min-h-screen overflow-x-hidden">
  <!-- Background image -->
  <div
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-90"
    style="background-image: url(<%= asset_path 'charredoak.png' %>);">
  </div>

  <!-- Gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-lagavulin-green/60 via-lagavulin-green/40 to-lagavulin-green/20"></div>

  <!-- Centered content -->
  <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-6xl items-center px-3 sm:px-4 md:px-6 py-12 sm:py-16">
    <div class="grid w-full gap-8 sm:gap-12 md:gap-16 md:grid-cols-2 md:items-center">

      <!-- Left side: Hero branding -->
      <div class="flex items-center justify-center md:justify-end">
        <%= image_tag "transparent_green_seal.png",
          alt: "Collective Spirits Wax Seal",
          class: "h-48 w-auto sm:h-64 md:h-80 lg:h-96 opacity-90 drop-shadow-[0_10px_40px_rgba(0,0,0,0.7)]" %>
      </div>

      <!-- Right side: Login form -->
      <div class="flex items-center justify-center md:justify-start">
        <div class="w-full max-w-md rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-4 py-6 sm:px-6 sm:py-8 md:px-8 md:py-10 shadow-2xl shadow-black/40">

          <% if flash[:alert].present? || flash[:notice].present? %>
            <div class="mb-6 rounded-xl border border-yellow-300 bg-yellow-50 px-4 py-3 text-xs sm:text-sm text-yellow-900">
              <p><%= flash[:alert] || flash[:notice] %></p>
            </div>
          <% end %>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="space-y-5 sm:space-y-6">

              <!-- Email -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :email, "Email", class: "sr-only" %>
                  Email
                </label>
                <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      placeholder: "name@example.com",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Password -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password, "Password", class: "sr-only" %>
                  Password
                </label>
                <%= f.password_field :password,
                      autocomplete: "current-password",
                      placeholder: "• • • • • • • •",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Submit -->
              <div class="pt-2">
                <%= f.submit "Enter the Club",
                      class: "inline-flex w-full items-center justify-center form-btn" %>
              </div>
            </div>
          <% end %>

          <div class="mt-5 border-t border-gray-200 pt-3 text-center text-[0.7rem] sm:text-xs md:text-sm text-gray-700">
            <%= render "devise/shared/links" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
