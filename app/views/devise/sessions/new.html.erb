<div class="min-h-[50vh] grid place-items-left px-6 py-10">
  <div class="w-full max-w-xl">
    <div class="rounded-2xl p-6 shadow-sm">
      <% if flash[:alert].present? || flash[:notice].present? %>
        <div class="mb-4 rounded-lg border border-yellow-300 bg-red-50 px-4 py-3 text-sm text-red-800">
          <%= flash[:alert] || flash[:notice] %>
        </div>
      <% end %>

      <!-- Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          
          <!-- Email -->
          <div>
            <%= f.label :email, class: "mb-1.5 block text-xl" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-black placeholder:text-gray-400 shadow-xs focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-100" %>
          </div>

          <!-- Password -->
          <div>
            <%= f.label :password, class: "mb-1.5 block text-xl" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-black placeholder:text-gray-400 shadow-xs focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-100" %>
          </div>

          <!-- Remember Me -->
          <% if devise_mapping.rememberable? %>
            <div>
              <label class="inline-flex items-center gap-2 text-xl">
                <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-sky-300" %>
                <span>Remember Me</span>
              </label>
            </div>
          <% end %>

          <!-- Submit -->
          <div class="text-center">
            <%= f.submit "Log in",
                  class: "inline-flex w-3/4 items-center justify-center rounded-xl px-4 py-2.5 ring-2 ring-sky-100 text-xl shadow-lg transition hover:scale-[1.02] hover:bg-stone-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-100 active:bg-stone-800" %>
          </div>

        </div>
      <% end %>

      <!-- Links -->
      <div class="mt-6 border-t border-gray-200 pt-4 text-center text-sm text-gray-700">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>
