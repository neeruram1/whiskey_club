
<div class="mx-auto w-full max-w-screen-xl px-6 py-12 md:py-16">
  <div class="grid gap-30 md:grid-cols-2 md:items-start">
    <div>
      <div class="mb-4 text-xl/10 uppercase tracking-widest text-shadow-md text-shadow-zinc-950 text-lagavulin-gold">Est. 2023</div>
        <h1 class="mb-4 text-6xl/19 font-semibold text-shadow-md tracking-wide text-shadow-zinc-950 text-lagavulin-gold">
          <span>COLLECTIVE SPIRITS </span>
          <span class="relative -top-3 text-5xl pb-[2px] font-of">of</span>
          <span> MONTCLAIR</span>
        </h1>
      <p class="mt-4 max-w-prose text-xl/10 tracking-wide text-shadow-lg text-shadow-zinc-950 text-lagavulin-gold">
        Poured in good company since… well, since we felt like it.
      </p>
    </div>
    <div>
      <div class="rounded-2xl border-4 border-lagavulin-gold ring-4 ring-lagavulin-green-light ring-offset-4 ring-offset-[#F8F5E9] bg-[#F8F5E9] p-6 shadow-xl">
        <% if flash[:alert].present? || flash[:notice].present? %>
          <div class="mb-4 rounded-lg border border-yellow-300 bg-yellow-50 px-4 py-3 text-sm text-yellow-900">
            <%= flash[:alert] || flash[:notice] %>
          </div>
        <% end %>
        
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="space-y-6">

            <%# Email %>
            <div>
              <div class="mb-2 flex items-baseline justify-between">
                <%= f.label :email, class: "text-lg tracking-widest text-shadow-sm uppercase text-shadow-lagavulin-green-light text-lagavulin-green" %>
              </div>
              <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    placeholder: "name@example.com",
                    class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-300 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/15" %>
            </div>

            <%# Password + Forgot link %>
            <div>
              <div class="mb-2 flex items-baseline justify-between">
                <%= f.label :password, class: "text-lg tracking-widest text-shadow-sm uppercase text-shadow-lagavulin-green-light text-lagavulin-green" %>
              </div>
              <%= f.password_field :password,
                    autocomplete: "current-password",
                    placeholder: "• • • • • • • •",
                    class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-300 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/15" %>
            </div>

            <%# Submit %>
            <div class="pt-1 text-center">
              <%= f.submit "Enter the club",
                    class: "inline-flex w-1/2 items-center justify-center rounded-4xl border-1 border-lagavulin-green bg-lagavulin-green px-4 py-3 text-sm tracking-widest text-shadow-sm uppercase font-semibold text-lagavulin-gold transition-colors duration-200 hover:bg-lagavulin-green-light hover:text-lagavulin-green focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lagavulin-gold/30 disabled:cursor-not-allowed disabled:opacity-50" %>
            </div>
          </div>
        <% end %>

        <div class="mt-6 border-t border-gray-200 pt-4 text-center text-sm text-gray-700">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>

  </div>
</div>
