<div class="relative min-h-screen bg-[#0f2a23] overflow-hidden">
  <!-- Background image -->
  <div
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-90"
    style="background-image: url(<%= asset_path 'charredoak.png' %>);">
  </div>

  <!-- Gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0f2a23]/70 via-[#0f2a23]/40 to-[#0f2a23]/10"></div>

  <!-- Centered content -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-5xl items-start px-4 py-10 sm:px-6 sm:py-12 md:items-center md:py-16">
    <div class="grid w-full gap-10 md:gap-16 md:grid-cols-2 md:items-start">

      <!-- Left side: Hero -->
      <div class="text-center md:text-left">
        <div class="mb-3 text-xs tracking-[0.3em] uppercase text-[#c9a24d]/80 sm:text-sm">
          Account Settings
        </div>

        <h1 class="mb-4 text-3xl sm:text-4xl md:text-6xl font-serif font-semibold tracking-wide text-[#c9a24d] leading-tight">
          Edit Account
        </h1>

        <p class="mt-4 mx-auto max-w-md text-base sm:text-lg md:text-xl tracking-wide text-[#c9a24d]/90">
          Update your details or change your password.
        </p>
      </div>

      <!-- Right side: Edit form -->
      <div class="mt-8 md:mt-0">
        <div class="rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-4 py-6 shadow-2xl shadow-black/40 sm:px-6 sm:py-8 md:px-8 md:py-10">
          <% if flash[:alert].present? || flash[:notice].present? %>
            <div class="mb-6 rounded-xl border border-yellow-300 bg-yellow-50 px-4 py-3 text-xs sm:text-sm text-yellow-900">
              <p><%= flash[:alert] || flash[:notice] %></p>
            </div>
          <% end %>
          <div class="mb-6 sm:mb-8 flex justify-center">
            <%= image_tag "transparent_green_seal.png",
              alt: "Collective Spirits Seal",
              class: "h-28 w-28 sm:h-36 sm:w-36 md:h-48 md:w-48 opacity-95 drop-shadow-[0_6px_20px_rgba(0,0,0,0.6)]" %>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <div class="space-y-5 sm:space-y-6">

              <!-- Email -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :email, class: "sr-only" %>
                  Email
                </label>
                <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      class: "block w-full rounded-xl border border-[#c9a24d]/30 bg-[#f8f5e9] px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-[#c9a24d] focus:outline-none focus:ring-4 focus:ring-[#c9a24d]/20" %>
              </div>

              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <p class="text-xs text-[#c9a24d]/80">
                  Currently waiting confirmation for <span class="font-medium"><%= resource.unconfirmed_email %></span>
                </p>
              <% end %>

              <!-- Password -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password, class: "sr-only" %>
                  Password
                </label>
                <p class="text-xs text-gray-400 mb-2">Leave blank if you don’t want to change it</p>
                <%= f.password_field :password,
                      autocomplete: "new-password",
                      placeholder: "• • • • • • • •",
                      class: "block w-full rounded-xl border border-[#c9a24d]/30 bg-[#f8f5e9] px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-[#c9a24d] focus:outline-none focus:ring-4 focus:ring-[#c9a24d]/20" %>
                <% if @minimum_password_length %>
                  <p class="text-xs text-gray-400 mt-1"><%= @minimum_password_length %> characters minimum</p>
                <% end %>
              </div>

              <!-- Password Confirmation -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password_confirmation, class: "sr-only" %>
                  Confirm Password
                </label>
                <%= f.password_field :password_confirmation,
                      autocomplete: "new-password",
                      placeholder: "Repeat password",
                      class: "block w-full rounded-xl border border-[#c9a24d]/30 bg-[#f8f5e9] px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-[#c9a24d] focus:outline-none focus:ring-4 focus:ring-[#c9a24d]/20" %>
              </div>

              <!-- Current Password -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :current_password, class: "sr-only" %>
                  Current Password
                </label>
                <p class="text-xs text-gray-400 mb-2">Required to confirm changes</p>
                <%= f.password_field :current_password,
                      autocomplete: "current-password",
                      placeholder: "••••••••",
                      class: "block w-full rounded-xl border border-[#c9a24d]/30 bg-[#f8f5e9] px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-[#c9a24d] focus:outline-none focus:ring-4 focus:ring-[#c9a24d]/20" %>
              </div>

              <!-- Submit -->
              <div class="pt-2">
                <%= f.submit "Update Account",
                      class: "inline-flex w-full items-center justify-center form-btn" %>
              </div>
            </div>
          <% end %>

          <!-- Cancel Account -->
          <div class="mt-8 pt-4 border-t border-[#c9a24d]/40">
            <h3 class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">Cancel Account</h3>
            <p class="text-xs text-gray-400 mb-3">Unhappy? This action is permanent.</p>
            <%= button_to "Cancel my account",
                  registration_path(resource_name),
                  method: :delete,
                  data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
                  class: "w-full bg-transparent border border-red-950 text-red-950 hover:bg-red-950 hover:text-white py-2 rounded-xl transition uppercase" %>
          </div>

          <!-- Back -->
          <div class="mt-6 text-center">
            <%= link_to "Back", :back, class: "form-btn" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
