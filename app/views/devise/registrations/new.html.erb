<div class="relative min-h-screen bg-[#0f2a23] overflow-hidden">
  <!-- Background image -->
  <div
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-90"
    style="background-image: url(<%= asset_path 'charredoak.png' %>);">
  </div>

  <!-- Gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0f2a23]/60 via-[#0f2a23]/30 to-[#0f2a23]/0"></div>

  <!-- Centered content -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-5xl items-center px-6 py-12 md:py-16">
    <div class="grid w-full gap-16 md:grid-cols-2 md:items-start">

      <!-- Left side: Hero + barrel image -->
      <div class="text-center md:text-left">
        <div class="mb-4 text-xl/10 uppercase tracking-widest text-lagavulin-gold">
          Est. 2023
        </div>

        <h1 class="mb-4 text-6xl/19 font-semibold tracking-wide text-lagavulin-gold">
          <span>COLLECTIVE SPIRITS </span>
          <span class="relative -top-3 text-5xl pb-[2px] font-of">of</span>
          <span> MONTCLAIR</span>
        </h1>

        <p class="mt-4 max-w-prose text-lg md:text-xl tracking-wide text-lagavulin-gold">
          Join the club to experience fine spirits with some fine spirits. 
        </p>
      </div>

      <!-- Right side: Sign up form -->
      
      <div>
        <div class="rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-6 py-8 md:px-8 md:py-10 shadow-2xl shadow-black/40">
          <% if flash[:alert].present? || flash[:notice].present? %>
            <div class="mb-6 rounded-xl border border-yellow-300 bg-yellow-50 px-4 py-3 text-sm text-yellow-900">
              <p><%= flash[:alert] || flash[:notice] %></p>
            </div>
          <% end %>

          <div class="mb-10 flex justify-center">
            <%= image_tag "transparent_green_seal.png",
              alt: "Collective Spirits Seal",
              class: "h-48 w-48 opacity-95 drop-shadow-[0_6px_20px_rgba(0,0,0,0.6)]" %>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <div class="space-y-6">
              <!-- First Name -->
              <div>
                <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :first_name, "First Name", class: "sr-only" %>
                  First Name
                </label>
                <%= f.text_field :first_name,
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>
              <!-- Last Name -->
              <div>
                <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :last_name, "Last Name", class: "sr-only" %>
                  Last Name
                </label>
                <%= f.text_field :last_name,
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>
              <!-- Email -->
              <div>
                <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :email, "Email", class: "sr-only" %>
                  Email
                </label>
                <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      placeholder: "name@example.com",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Password -->
              <div>
                <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password, "Password", class: "sr-only" %>
                  Password
                </label>
                <%= f.password_field :password,
                      autocomplete: "new-password",
                      placeholder: "• • • • • • • •",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Password confirmation -->
              <div>
                <label class="mb-2 block text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password_confirmation, "Confirm Password", class: "sr-only" %>
                  Confirm Password
                </label>
                <%= f.password_field :password_confirmation,
                      autocomplete: "new-password",
                      placeholder: "Repeat password",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Submit -->
              <div class="pt-2">
                <%= f.submit "Request Membership",
                      class: "inline-flex w-full items-center justify-center form-btn" %>
              </div>
            </div>
          <% end %>

          <div class="mt-6 border-t border-gray-200 pt-4 text-center text-xs md:text-sm text-gray-700">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

