<div class="relative min-h-screen">
  <!-- Background image -->
  <div
    class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-90"
    style="background-image: url(<%= asset_path 'charredoak.png' %>);">
  </div>

  <!-- Gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-lagavulin-green/60 via-lagavulin-green/40 to-lagavulin-green/20"></div>

  <!-- Centered content -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-5xl items-start px-4 py-10 sm:px-6 sm:py-12 md:items-center md:py-16">
    <div class="grid w-full gap-10 md:gap-16 md:grid-cols-2 md:items-start">

      <!-- Left side: Hero -->
      <div class="text-center md:text-left">
        <div class="mb-3 text-xs tracking-[0.3em] uppercase text-lagavulin-gold/80 sm:text-sm">
          Est. 2023
        </div>

        <h1 class="mb-4 text-3xl sm:text-4xl md:text-6xl font-semibold tracking-wide text-lagavulin-gold leading-tight">
          <span>COLLECTIVE SPIRITS </span>
          <span class="relative -top-1 sm:-top-2 md:-top-3 text-2xl sm:text-3xl md:text-5xl pb-[2px] font-of">
            of
          </span>
          <span> MONTCLAIR</span>
        </h1>

        <p class="mt-4 mx-auto max-w-md text-base sm:text-lg md:text-xl tracking-wide text-lagavulin-gold/90">
          Join the club to experience fine spirits with some fine spirits.
        </p>
      </div>

      <!-- Right side: Sign up form -->
      <div class="mt-8 md:mt-0">
        <div class="rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-4 py-6 shadow-2xl shadow-black/40 sm:px-6 sm:py-8 md:px-8 md:py-10">
          <% if flash[:alert].present? || flash[:notice].present? %>
            <div class="mb-6 rounded-xl border border-yellow-300 bg-yellow-50 px-4 py-3 text-xs sm:text-sm text-yellow-900">
              <p><%= flash[:alert] || flash[:notice] %></p>
            </div>
          <% end %>

          <div class="mb-6 sm:mb-8 flex justify-center">
            <%= image_tag "transparent_green_seal.png",
              alt: "Collective Spirits Seal",
              class: "h-28 w-28 sm:h-36 sm:w-36 md:h-48 md:w-48 opacity-95 drop-shadow-[0_6px_20px_rgba(0,0,0,0.6)]" %>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <div class="space-y-5 sm:space-y-6">
              <!-- First Name -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :first_name, "First Name", class: "sr-only" %>
                  First Name
                </label>
                <%= f.text_field :first_name,
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Last Name -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :last_name, "Last Name", class: "sr-only" %>
                  Last Name
                </label>
                <%= f.text_field :last_name,
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Email -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :email, "Email", class: "sr-only" %>
                  Email
                </label>
                <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      placeholder: "name@example.com",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Password -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password, "Password", class: "sr-only" %>
                  Password
                </label>
                <%= f.password_field :password,
                      autocomplete: "new-password",
                      placeholder: "• • • • • • • •",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Password confirmation -->
              <div>
                <label class="mb-1.5 block text-xs sm:text-sm font-semibold uppercase tracking-widest text-lagavulin-green">
                  <%= f.label :password_confirmation, "Confirm Password", class: "sr-only" %>
                  Confirm Password
                </label>
                <%= f.password_field :password_confirmation,
                      autocomplete: "new-password",
                      placeholder: "Repeat password",
                      class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3 py-2.5 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              </div>

              <!-- Submit -->
              <div class="pt-2">
                <%= f.submit "Request Membership",
                      class: "inline-flex w-full items-center justify-center form-btn" %>
              </div>
            </div>
          <% end %>

          <div class="mt-5 border-t border-gray-200 pt-3 text-center text-[0.7rem] sm:text-xs md:text-sm text-gray-700">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
