<%= turbo_frame_tag "modal" do %>
  <!-- Modal backdrop -->
  <div class="fixed inset-0 z-[60] flex items-start justify-center overflow-y-auto bg-black/60 px-4 pt-24 pb-12" data-controller="modal" data-action="click->modal#closeBackground">
    <div class="relative w-full max-w-xl" data-action="click->modal#stopPropagation">
      <!-- Close button -->
      <button type="button" data-action="modal#close" class="absolute -top-2 -right-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-lagavulin-gold text-2xl font-bold text-black hover:bg-lagavulin-gold/90 transition shadow-lg">×</button>
      
      <div class="rounded-3xl border border-lagavulin-green/40 bg-[#F8F5E9] px-6 py-8 md:px-8 md:py-10 shadow-2xl shadow-black/50">
        <!-- Header -->
        <div class="mb-6 text-center">
          <h2 class="heading-sub text-lagavulin-green">Edit Account</h2>
          <p class="mt-2 meta-sm text-lagavulin-green/70">Update your profile details</p>
        </div>

        <!-- Errors -->
        <% if resource.errors.any? %>
          <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3">
            <p class="label-sm text-red-900 mb-2">Please fix the following:</p>
            <ul class="list-disc list-inside body-sm text-red-800 space-y-1">
              <% resource.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= render 'edit_form', resource: resource %>
      </div>
    </div>
  </div>
<% end %>
