<div class="relative min-h-screen">
  <!-- Content -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-md items-center px-4 py-10 sm:px-6">
    <div class="w-full">
      <div class="rounded-3xl border border-lagavulin-gold/40 bg-[#F8F5E9] px-6 py-8 md:px-8 md:py-10 shadow-2xl shadow-black/40">
        <!-- Header -->
        <div class="mb-6 text-center">
          <%= image_tag "transparent_green_seal.png",
            alt: "Collective Spirits Seal",
            class: "mx-auto h-32 w-32 mb-4 opacity-95 drop-shadow-[0_6px_20px_rgba(0,0,0,0.6)]" %>
          <h2 class="heading-sub text-lagavulin-green">Set New Password</h2>
          <p class="mt-2 meta-sm text-lagavulin-green/70">Choose a secure password for your account</p>
        </div>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="space-y-6">
            <!-- New Password -->
            <div>
              <%= f.label :password, class: "mb-2 block label-sm text-lagavulin-green" do %>
                New Password
              <% end %>
              <%= f.password_field :password,
                    autofocus: true,
                    autocomplete: "new-password",
                    placeholder: "Enter new password",
                    class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
              <% if @minimum_password_length %>
                <p class="mt-1 meta-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
              <% end %>
            </div>

            <!-- Confirm Password -->
            <div>
              <%= f.label :password_confirmation, class: "mb-2 block label-sm text-lagavulin-green" do %>
                Confirm New Password
              <% end %>
              <%= f.password_field :password_confirmation,
                    autocomplete: "new-password",
                    placeholder: "Repeat new password",
                    class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20" %>
            </div>

            <!-- Submit -->
            <div class="pt-2">
              <%= f.submit "Change Password", class: "inline-flex w-full items-center justify-center form-btn" %>
            </div>
          </div>
        <% end %>

        <!-- Links -->
        <div class="mt-6 border-t border-lagavulin-green/20 pt-4 text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
