<%# locals: bottle:, current_user_rating: (Rating or nil), show_flavors: true %>
<% show_flavors = local_assigns.fetch(:show_flavors, true) %>

<section class="rounded-2xl border border-lagavulin-gold/18 bg-black/10 p-4 sm:p-5">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">

    <!-- Status -->
    <div class="space-y-1">
      <p class="label-xs text-lagavulin-gold/70">
        Rating
      </p>

      <% if current_user_rating&.score.present? %>
        <p class="body-sm text-lagavulin-gold">
          <span class="text-lagavulin-gold/70">Your rating:</span>
          <span class="font-semibold"><%= number_with_precision(current_user_rating.score, precision: 1) %></span>
          <span class="text-lagavulin-gold/60">/ 5</span>
        </p>
      <% else %>
        <p class="body-sm text-lagavulin-gold/75">
          <span class="text-lagavulin-gold/70">Your rating:</span>
          <span class="text-lagavulin-gold/55">—</span>
          <span class="text-lagavulin-gold/60">/ 5</span>
        </p>
      <% end %>

      <p class="meta-xs text-lagavulin-gold/45">
        0.1 increments allowed
      </p>
    </div>

    <!-- (Optional) small hint on the right; remove if you want even cleaner -->
    <div class="label-sm text-lagavulin-gold/65">
      1.0–5.0
    </div>
  </div>

  <div class="mt-4">
    <%= form_with url: current_user_rating.present? ? rating_path(current_user_rating) : ratings_path, 
                  method: current_user_rating.present? ? :patch : :post, 
                  local: true,
                  class: "space-y-4" do %>

      <%= hidden_field_tag "rating[bottle_id]", bottle.id %>
      <%= hidden_field_tag "rating[score]", current_user_rating&.score || 0, id: "rating_score_field_#{bottle.id}" %>

      <div>
        <label class="block label-sm text-lagavulin-gold/70 mb-3">
          Select Rating
        </label>

        <!-- Star Rating Slider -->
        <div class="space-y-3">
          <!-- Visual stars -->
          <div class="flex items-center gap-2" id="star-rating-<%= bottle.id %>">
            <% 5.times do |i| %>
              <button type="button" 
                      data-value="<%= i + 1 %>"
                      class="star-btn text-4xl sm:text-5xl transition-all duration-150 focus:outline-none focus:scale-110"
                      onclick="setRating_<%= bottle.id %>(<%= i + 1 %>)">
                <span class="star-empty">☆</span>
                <span class="star-filled hidden">★</span>
              </button>
            <% end %>
          </div>

          <!-- Slider for fine-tuning -->
          <div class="flex items-center gap-3">
            <input type="range" 
                   id="rating_slider_<%= bottle.id %>"
                   min="1" 
                   max="5" 
                   step="0.1" 
                   value="<%= current_user_rating&.score || 3 %>"
                   oninput="updateRatingFromSlider_<%= bottle.id %>(this.value)"
                   class="flex-1 h-2 bg-black/30 rounded-full appearance-none cursor-pointer
                          [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-5 
                          [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-lagavulin-gold 
                          [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:shadow-lg
                          [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:rounded-full 
                          [&::-moz-range-thumb]:bg-lagavulin-gold [&::-moz-range-thumb]:cursor-pointer 
                          [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:shadow-lg" />
            
            <span id="rating_display_<%= bottle.id %>" class="text-2xl font-semibold text-lagavulin-gold tracking-wider min-w-[3rem] text-center">
              <%= current_user_rating&.score || 3.0 %>
            </span>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block label-sm text-lagavulin-gold/70">
            Flavor Profile <span class="meta-xs text-lagavulin-gold/50">(optional)</span>
          </label>
          <button type="button" 
                  onclick="document.getElementById('flavor-list-<%= bottle.id %>').classList.toggle('hidden'); this.querySelector('.toggle-icon').classList.toggle('rotate-180');"
                  class="text-lagavulin-gold/70 hover:text-lagavulin-gold transition-colors">
            <svg class="w-5 h-5 toggle-icon transition-transform <%= show_flavors ? '' : 'rotate-180' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div id="flavor-list-<%= bottle.id %>" class="<%= show_flavors ? '' : 'hidden' %> space-y-1.5 max-h-48 overflow-y-auto">
          <% Rating::FLAVORS.each do |flavor| %>
            <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-black/20 cursor-pointer transition-colors">
              <%= check_box_tag "rating[flavors][]", flavor, 
                    current_user_rating&.flavors&.include?(flavor),
                    class: "rounded border-lagavulin-gold/40 text-lagavulin-gold focus:ring-lagavulin-gold/30 cursor-pointer",
                    id: "flavor_#{flavor.downcase.gsub(' ', '_')}_#{bottle.id}" %>
              <span class="label-sm text-lagavulin-gold/80"><%= flavor %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="mt-4">
        <label class="block label-sm text-lagavulin-gold/70 mb-2">
          Comment <span class="meta-xs text-lagavulin-gold/50">(optional)</span>
        </label>
        <%= text_area_tag "rating[comment]", current_user_rating&.comment, 
              placeholder: "Share your tasting notes...",
              maxlength: 500,
              class: "block w-full rounded-xl border border-lagavulin-green/30 bg-white px-3.5 py-3 text-base text-gray-900 placeholder:text-gray-400 shadow-sm focus:border-lagavulin-green focus:outline-none focus:ring-4 focus:ring-lagavulin-green/20",
              rows: 3 %>
        <p class="mt-1 meta-xs text-lagavulin-gold/50">
          Max 500 characters
        </p>
      </div>

      <div class="flex items-center justify-between pt-2">
        <p class="meta-xs text-lagavulin-gold/65">
          Tap stars or slide for precision
        </p>
        <%= submit_tag(current_user_rating.present? ? "Update Rating" : "Submit Rating",
              class: "btn-mini") %>
      </div>
    <% end %>
  </div>

  <script>
    function setRating_<%= bottle.id %>(value) {
      updateRating_<%= bottle.id %>(value);
      document.getElementById('rating_slider_<%= bottle.id %>').value = value;
    }

    function updateRatingFromSlider_<%= bottle.id %>(value) {
      updateRating_<%= bottle.id %>(parseFloat(value));
    }

    function updateRating_<%= bottle.id %>(value) {
      const rounded = Math.round(value * 10) / 10;
      document.getElementById('rating_score_field_<%= bottle.id %>').value = rounded;
      document.getElementById('rating_display_<%= bottle.id %>').textContent = rounded.toFixed(1);
      
      // Update stars
      const stars = document.querySelectorAll('#star-rating-<%= bottle.id %> .star-btn');
      stars.forEach((star, index) => {
        const starValue = index + 1;
        const empty = star.querySelector('.star-empty');
        const filled = star.querySelector('.star-filled');
        
        if (starValue <= Math.floor(value)) {
          empty.classList.add('hidden');
          filled.classList.remove('hidden');
          filled.style.color = '#C9A968';
        } else if (starValue === Math.ceil(value) && value % 1 !== 0) {
          // Partial star
          empty.classList.add('hidden');
          filled.classList.remove('hidden');
          filled.style.color = `rgba(201, 169, 104, ${value % 1})`;
        } else {
          empty.classList.remove('hidden');
          filled.classList.add('hidden');
        }
      });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
      const slider = document.getElementById('rating_slider_<%= bottle.id %>');
      if (slider) {
        const initialValue = parseFloat(slider.value);
        updateRating_<%= bottle.id %>(initialValue);
      }
    });

    document.addEventListener('turbo:load', function() {
      const slider = document.getElementById('rating_slider_<%= bottle.id %>');
      if (slider) {
        const initialValue = parseFloat(slider.value);
        updateRating_<%= bottle.id %>(initialValue);
      }
    });
  </script>
</section>

