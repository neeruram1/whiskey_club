<%# locals: bottle:, current_user_rating: (Rating or nil) %>

<section class="mt-8 rounded-3xl border border-lagavulin-gold/25 bg-black/20 p-5 sm:p-7 shadow-lg shadow-black/40">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-1">
      <p class="text-xs tracking-[0.32em] uppercase text-lagavulin-gold/70">Your rating</p>

      <% if current_user_rating&.score.present? %>
        <p class="text-[#E8D6A7] text-2xl font-semibold tracking-wide">
          <%= number_with_precision(current_user_rating.score, precision: 1) %>
          <span class="text-[#E8D6A7]/60 text-sm font-medium">/ 10</span>
        </p>
        <p class="text-xs tracking-widest text-[#E8D6A7]/60">Adjust anytime.</p>
      <% else %>
        <p class="text-sm tracking-widest text-[#E8D6A7]/70">Not rated yet.</p>
      <% end %>
    </div>

    <div class="text-xs tracking-[0.3em] uppercase text-[#E8D6A7]/50">1.0–10.0</div>
  </div>

  <div class="mt-4">
    <%= form_with url: ratings_path, method: :post, local: true,
          class: "flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4" do %>

      <%= hidden_field_tag "rating[bottle_id]", bottle.id %>

      <div>
        <label class="block text-xs tracking-[0.32em] uppercase text-[#E8D6A7]/60 mb-2">
          Score
        </label>

        <%= number_field_tag "rating[score]",
              current_user_rating&.score,
              in: 1..10,
              step: 0.1,
              required: true,
              inputmode: "decimal",
              placeholder: "8.7",
              class: "w-full sm:w-32 rounded-xl border border-lagavulin-gold/35 bg-[#0b201b]/70
                      px-3 py-2 text-base text-[#E8D6A7] placeholder:text-[#E8D6A7]/35
                      focus:border-lagavulin-gold focus:outline-none focus:ring-4 focus:ring-lagavulin-gold/15" %>
      </div>

      <div class="pt-1">
        <%= submit_tag(current_user_rating.present? ? "Save changes" : "Save rating",
              class: "inline-flex w-full sm:w-auto items-center justify-center form-btn") %>

        <p class="mt-2 text-[0.7rem] tracking-widest text-[#E8D6A7]/45">
          Saved to your profile immediately.
        </p>
      </div>
    <% end %>
  </div>
</section>
