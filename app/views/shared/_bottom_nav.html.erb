<%# The installed app's primary navigation. Hidden in a browser tab, where the
    toolbar already does this job — see the standalone: variant.

    The active tab is marked with a short brass rule across the top of its
    column, borrowing the hoop on the casks in the club's seal, rather than the
    usual filled pill. %>
<nav class="hidden standalone:block fixed inset-x-0 bottom-0 z-40 border-t border-lagavulin-gold/25
            bg-lagavulin-green/90 supports-[backdrop-filter]:backdrop-blur-md
            pb-[env(safe-area-inset-bottom)]"
     aria-label="Sections">
  <ul class="mx-auto flex w-full max-w-screen-sm items-stretch">
    <%
      tabs = [
        { label: "Home",     path: root_path,
          icon: "M3 10.5 12 3l9 7.5M5.25 9.75V20.25h13.5V9.75" },
        { label: "Tastings", path: meetings_path,
          icon: "M6.75 3v2.25M17.25 3v2.25M3.75 7.5h16.5M4.5 5.25h15a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-15a.75.75 0 0 1-.75-.75V6a.75.75 0 0 1 .75-.75Z" },
        { label: "Bottles",  path: archives_path,
          icon: "M10.5 3h3v3.75l2.06 2.47a3 3 0 0 1 .69 1.92v8.11a1.5 1.5 0 0 1-1.5 1.5h-6a1.5 1.5 0 0 1-1.5-1.5v-8.11a3 3 0 0 1 .69-1.92L10.5 6.75V3Z" },
        { label: "Stats",    path: stats_path,
          icon: "M4.5 19.5V12M9.75 19.5V6.75M15 19.5v-4.5M20.25 19.5V9.75" }
      ]
    %>
    <% tabs.each do |tab| %>
      <% active = tab_current?(tab[:path]) %>
      <li class="flex-1">
        <%= link_to tab[:path],
              class: "relative flex flex-col items-center justify-center gap-1 px-2 pt-3 pb-2 min-h-[3.5rem]
                      transition-colors #{active ? 'text-lagavulin-gold' : 'text-lagavulin-gold/55 hover:text-lagavulin-gold/80'}",
              aria: { current: (active ? "page" : nil) } do %>
          <% if active %>
            <span class="absolute inset-x-0 top-0 mx-auto h-px w-8 bg-lagavulin-gold" aria-hidden="true"></span>
          <% end %>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
               stroke-width="<%= active ? '1.9' : '1.5' %>" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= tab[:icon] %>" />
          </svg>
          <span class="text-[0.6rem] tracking-[0.18em] uppercase leading-none"><%= tab[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
