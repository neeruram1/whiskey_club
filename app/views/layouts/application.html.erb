<!DOCTYPE html>
<html class="overflow-x-hidden">
  <head>
    <title>Collective Spirits of Montclair</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Installable app: manifest drives Android/desktop install, the apple-*
        tags are how iOS still does it from Share → Add to Home Screen. %>
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <meta name="theme-color" content="#050f0a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Collective Spirits">
    <link rel="apple-touch-icon" href="<%= asset_path('apple-touch-icon.png') %>">
    <link rel="icon" type="image/png" sizes="192x192" href="<%= asset_path('icon-192.png') %>">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen overflow-x-hidden" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" 
       class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 
              focus:rounded-lg focus:bg-lagavulin-gold focus:px-4 focus:py-2 
              focus:text-lagavulin-green focus:font-semibold focus:tracking-widest">
      Skip to main content
    </a>
    
    <!-- Global background wrapper -->
    <div class="fixed inset-0 z-0 overflow-hidden">
      <!-- Background image -->
      <div
        class="absolute inset-0 bg-cover bg-center opacity-90 bg-[#0f2a23]"
        style="background-image: url(<%= asset_path 'charredoak.png' %>);">
      </div>

      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-lagavulin-green/60 via-lagavulin-green/40 to-lagavulin-green/20"></div>
    </div>

      <!-- App shell -->
      <div class="relative z-10 flex min-h-screen flex-col overflow-x-hidden">
        <% hide_shell = current_page?(new_user_session_path) || current_page?(new_user_registration_path) %>

        <% unless hide_shell %>
          <header class="sticky top-0 z-40 border-b border-lagavulin-gold/30 bg-lagavulin-green/70 supports-[backdrop-filter]:backdrop-blur-md" role="banner">
            <%# Installed on iOS the page runs under the translucent status bar,
                so the top padding has to clear the battery/wifi icons — without
                the inset they sit on top of the Menu button. env() is 0 in a
                normal browser tab, so this is a no-op on the web. %>
            <div class="mx-auto w-full max-w-screen-xl px-4 pb-2.5 pt-[calc(0.625rem_+_env(safe-area-inset-top))] sm:px-4 md:px-6"
                 data-controller="menu"
                 data-action="keydown@window->menu#closeOnEscape click@window->menu#closeOnOutsideClick">
              <nav class="flex items-center justify-between gap-4" aria-label="Main navigation">
                <div class="flex min-w-0 items-center">
                  <%# Back, for the installed app only — a browser tab has its own.
                      Hidden on section roots, which the bottom bar already reaches. %>
                  <% unless section_root? %>
                    <button type="button"
                            class="hidden standalone:flex -ml-2 mr-1 h-11 w-9 flex-shrink-0 items-center justify-center
                                   text-lagavulin-gold/80 hover:text-lagavulin-gold transition-colors"
                            data-controller="back"
                            data-action="back#go"
                            aria-label="Go back">
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5.25 8.25 12 15 18.75" />
                      </svg>
                    </button>
                  <% end %>

                  <!-- Left: wordmark -->
                  <%= link_to root_path, class: "group flex flex-col gap-0.5 flex-shrink-0" do %>
                    <span class="text-xs tracking-[0.28em] uppercase text-lagavulin-gold/90 transition group-hover:text-lagavulin-gold whitespace-nowrap leading-none">
                      Collective Spirits
                    </span>
                    <span class="font-of text-sm text-lagavulin-gold/70 transition group-hover:text-lagavulin-gold/90 leading-none">
                      of Montclair
                    </span>
                  <% end %>
                </div>

                <!-- Mobile menu button -->
                <button type="button"
                        class="lg:hidden inline-flex items-center gap-2 px-3 py-2 rounded-md text-lagavulin-gold/70 hover:text-lagavulin-gold hover:bg-black/20 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-lagavulin-gold/50 transition"
                        aria-controls="mobile-menu"
                        aria-expanded="false"
                        data-menu-target="button"
                        data-action="menu#toggle">
                  <span class="text-sm font-medium tracking-wider uppercase">Menu</span>
                  <svg class="block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                  </svg>
                </button>

                <!-- Desktop nav (hidden on mobile & tablet) -->
                <div class="hidden lg:flex lg:items-center lg:gap-x-4 xl:gap-x-5 flex-wrap">
                  <%= link_to "Home", root_path, class: "link-mini" %>
                  <%= link_to "Bottles", archives_path, class: "link-mini" %>
                  <%= link_to "Tastings", meetings_path, class: "link-mini" %>
                  <%= link_to "Stats", stats_path, class: "link-mini" %>
                  <%= link_to "Encore Pours", wishlist_path, class: "link-mini" %>
                  <a href="<%= new_meeting_path %>" class="link-mini" data-turbo-frame="modal">Schedule</a>

                  <% if user_signed_in? %>
                    <span class="text-lagavulin-gold/30">|</span>
                    <% if current_user.admin? %>
                      <%= link_to "Admin", admin_users_path, class: "link-mini" %>
                    <% end %>
                    <%= link_to "Profile", user_path(current_user), class: "link-mini" %>
                    <a href="<%= edit_user_registration_path %>" class="link-mini" data-turbo-frame="modal">Account</a>
                    <%= link_to "Log out", destroy_user_session_path, class: "link-mini", data: { turbo_method: :delete, turbo_confirm: "Log out of your account?" } %>
                  <% end %>
                </div>
              </nav>

              <!-- Mobile menu (hidden by default, outside sticky nav) -->
              <div class="hidden lg:hidden mt-3 space-y-1 pb-3" id="mobile-menu" data-menu-target="panel">
                  <%= link_to "Home", root_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Bottle Archive", archives_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Tasting Archive", meetings_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Stats", stats_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Encore Pours", wishlist_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <a href="<%= new_meeting_path %>" class="block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" data-turbo-frame="modal">Schedule</a>

                  <% if user_signed_in? %>
                    <% if current_user.admin? %>
                      <%= link_to "Admin", admin_users_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                    <% end %>
                    <%= link_to "Profile", user_path(current_user), class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                    <a href="<%= edit_user_registration_path %>" class="block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" data-turbo-frame="modal">Edit account</a>

                    <%= button_to destroy_user_session_path,
                          method: :delete,
                          form: { class: "w-full" },
                          class: "w-full text-left px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition",
                          data: { turbo: false, turbo_confirm: "Log out of your account?" },
                          aria: { label: "Log out" } do %>
                      Log out
                    <% end %>
                  <% end %>
                </div>

              <% if user_signed_in? %>
                <p class="mt-2 meta-xs text-lagavulin-gold/70">
                  Signed in as <%= link_to current_user.full_name, user_path(current_user), class: "text-lagavulin-gold/90 hover:text-lagavulin-gold underline decoration-lagavulin-gold/30 underline-offset-2 hover:decoration-lagavulin-gold transition-colors" %>
                </p>
              <% end %>
            </div>
          </header>
        <% end %>

        <%# Sign-in and sign-up hide the header, so nothing else is holding the
            content clear of the status bar on an installed phone. The bottom
            padding clears the tab bar, which is fixed over the page. %>
        <main id="main-content"
              class="flex-1 <%= 'pt-[env(safe-area-inset-top)]' if hide_shell %>
                     <%= 'standalone:pb-[calc(4.5rem_+_env(safe-area-inset-bottom))]' unless hide_shell %>"
              role="main" aria-label="Main content">
          <!-- Flash messages (centered; mobile safe) -->
          <div class="pointer-events-none fixed top-[calc(1rem_+_env(safe-area-inset-top))] left-3 right-3 z-50 mx-auto max-w-xs sm:max-w-sm sm:top-[calc(1.5rem_+_env(safe-area-inset-top))] sm:left-1/2 sm:right-auto sm:-translate-x-1/2">
            <div id="flash-messages" class="pointer-events-auto">
              <%= render "shared/flash" %>
            </div>
          </div>

          <%= yield %>
        </main>

        <% unless hide_shell %>
          <%# Bottom inset clears the iPhone home indicator. Hidden in the
              installed app, where the tab bar occupies that edge instead. %>
          <footer class="standalone:hidden border-t border-lagavulin-gold/25 bg-lagavulin-green/40 supports-[backdrop-filter]:backdrop-blur-md pt-8 pb-[calc(2rem_+_env(safe-area-inset-bottom))] sm:pt-10 sm:pb-[calc(2.5rem_+_env(safe-area-inset-bottom))]" role="contentinfo" aria-label="Footer">
            <div class="mx-auto max-w-screen-xl px-4 text-center space-y-3 sm:px-6 sm:space-y-4">
              <p class="label-xs text-lagavulin-gold/65">
                Collective Spirits of Montclair · Est. 2023
              </p>

              <p class="meta-xs text-lagavulin-gold/65">
                A private whiskey club for friends with good taste.
              </p>
            </div>
          </footer>
        <% end %>
      </div>

    <% unless hide_shell %>
      <%= render "shared/bottom_nav" %>
    <% end %>

    <%= turbo_frame_tag "modal" %>

    <script>
      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        // Only activate if not in an input field
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
          return;
        }
        
        // CMD/CTRL + K: Focus search (if exists)
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          const searchInput = document.querySelector('[type="search"]');
          if (searchInput) {
            searchInput.focus();
            searchInput.select();
          }
        }
        
        // G + H: Go to home
        if (e.key === 'g') {
          const nextKey = new Promise(resolve => {
            const handler = (ev) => {
              document.removeEventListener('keydown', handler);
              resolve(ev.key);
            };
            document.addEventListener('keydown', handler);
            setTimeout(() => {
              document.removeEventListener('keydown', handler);
              resolve(null);
            }, 1000);
          });
          
          nextKey.then(key => {
            if (key === 'h') window.location.href = '/';
            if (key === 'a') {
              const archiveLink = document.querySelector('a[href*=\"archives\"]');
              if (archiveLink) window.location.href = archiveLink.href;
            }
            if (key === 'n') {
              const newMeetingLink = document.querySelector('a[href*=\"meetings/new\"]');
              if (newMeetingLink) window.location.href = newMeetingLink.href;
            }
          });
        }
        
        // ?: Show keyboard shortcuts help
        if (e.shiftKey && e.key === '?') {
          e.preventDefault();
          alert('Keyboard Shortcuts:\\n\\n' +
                'g + h: Go to Home\\n' +
                'g + a: Go to Browse\n' +
                'g + n: New Tasting\\n' +
                '⌘/Ctrl + K: Focus search\\n' +
                '?: Show this help');
        }
      });

      function setupFlashFade() {
        const flashContainer = document.getElementById("flash-messages");
        if (!flashContainer) return;

        const messages = flashContainer.querySelectorAll(".flash-message");
        if (!messages.length) return;

        // Start fade after 1.6s (slightly calmer)
        setTimeout(() => {
          messages.forEach((el) => {
            el.style.opacity = "0";
            el.style.transform = "translateY(-6px)";
          });

          // Remove from DOM after transition
          setTimeout(() => {
            flashContainer.innerHTML = "";
          }, 900);
        }, 1600);
      }

      document.addEventListener("turbo:load", setupFlashFade);
      document.addEventListener("DOMContentLoaded", setupFlashFade);
    </script>
  </body>
</html>


