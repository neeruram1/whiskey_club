<!DOCTYPE html>
<html>
  <head>
    <title>Collective Spirits of Montclair</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
    <body class="bg-lagavulin-green min-h-screen flex flex-col">
      <header class="px-6 py-4 border-b border-lagavulin-gold">
        <div class="mx-auto max-w-screen-xl flex items-center">
          <span class="text-2xl tracking-wide text-shadow-md text-shadow-zinc-950 text-lagavulin-gold">
            COLLECTIVE SPIRITS
          <span class="relative -top-1 text-lg text-lagavulin-gold text-shadow-md text-shadow-zinc-950 font-of pb-[1px]">of</span>
            MONTCLAIR
          </span>
        </div>
      </header>

      <main class="flex-1">
        <%= yield %>
      </main>
    </body>
</html>
