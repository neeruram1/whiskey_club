<!DOCTYPE html>
<html>
  <head>
    <title>Collective Spirits of Montclair</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-lagavulin-green min-h-screen flex flex-col">
    <% unless current_page?(new_user_session_path) || current_page?(new_user_registration_path) %>
      <header class="border-b border-lagavulin-gold bg-[#0f2a23]/95 backdrop-blur">
        <div class="mx-auto flex max-w-screen-xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          
          <!-- Left: logo + wordmark + user -->
          <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-6">
            <%= link_to root_path, class: "flex items-center" do %>
              <span class="text-[0.7rem] tracking-[0.25em] uppercase text-lagavulin-gold sm:text-sm sm:tracking-[0.3em] md:text-base">
                Collective Spirits
                <span class="font-of text-[0.9em] align-middle">of</span>
                Montclair
              </span>
            <% end %>
          </div>

          <!-- Right: logout -->
          <% if user_signed_in? %>
            <div class="flex justify-start sm:justify-end">
                <%= link_to "Edit Account", edit_user_registration_path, class: "link-mini" %>
            </div>
            <div class="text-sm text-lagavulin-gold/70 sm:right-6">
              <span class="font-semibold text-lagavulin-gold/90">
                  <%= button_to "Log Out",
                    destroy_user_session_path,
                    method: :delete,
                    class: "btn-mini" %>
              </span>
          <% end %>
        </div>
      </header>
    <% end %>

    <main class="flex-1">
      <!-- Flash messages, centered and mobile-friendly -->
      <div class="fixed top-4 left-1/2 z-50 w-full max-w-sm -translate-x-1/2 px-4 sm:top-6">
        <div id="flash-messages">
          <%= render "shared/flash" %>
        </div>
      </div>

      <%= yield %>
    </main>

    <footer class="relative border-t border-lagavulin-gold bg-[#0f2a23]/95 py-8 sm:py-10">
      <div class="mx-auto max-w-screen-xl px-4 text-center space-y-3 sm:px-6 sm:space-y-4">
        <p class="mt-1 text-[0.65rem] tracking-[0.3em] uppercase text-lagavulin-gold/70 sm:text-xs">
          Collective Spirits of Montclair · Est. 2023
        </p>

        <p class="text-[0.6rem] tracking-widest text-[#E8D6A7]/40 sm:text-[0.65rem]">
          A private whiskey club for friends with good taste.
        </p>
      </div>
    </footer>

    <script>
      function setupFlashFade() {
        const flashContainer = document.getElementById("flash-messages");
        if (!flashContainer) return;

        const messages = flashContainer.querySelectorAll(".flash-message");
        if (!messages.length) return;

        // Start fade after 1.5s
        setTimeout(() => {
          messages.forEach((el) => {
            el.style.opacity = "0";
            el.style.transform = "translateY(-6px)";
            el.style.boxShadow = "0 0 0 rgba(201,169,104,0)";
          });

          // Remove from DOM after transition
          setTimeout(() => {
            flashContainer.innerHTML = "";
          }, 800);
        }, 1500);
      }

      document.addEventListener("turbo:load", setupFlashFade);
      document.addEventListener("DOMContentLoaded", setupFlashFade);
    </script>
  </body>
</html>
