<!DOCTYPE html>
<html class="overflow-x-hidden">
  <head>
    <title>Collective Spirits of Montclair</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen overflow-x-hidden" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" 
       class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 
              focus:rounded-lg focus:bg-lagavulin-gold focus:px-4 focus:py-2 
              focus:text-lagavulin-green focus:font-semibold focus:tracking-widest">
      Skip to main content
    </a>
    
    <!-- Global background wrapper -->
    <div class="fixed inset-0 z-0 overflow-hidden">
      <!-- Background image -->
      <div
        class="absolute inset-0 bg-cover bg-center opacity-90 bg-[#0f2a23]"
        style="background-image: url(<%= asset_path 'charredoak.png' %>);">
      </div>

      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-lagavulin-green/60 via-lagavulin-green/40 to-lagavulin-green/20"></div>
    </div>

      <!-- App shell -->
      <div class="relative z-10 flex min-h-screen flex-col overflow-x-hidden">
        <% hide_shell = current_page?(new_user_session_path) || current_page?(new_user_registration_path) %>

        <% unless hide_shell %>
          <header class="sticky top-0 z-40 border-b border-lagavulin-gold/30 bg-lagavulin-green/70 supports-[backdrop-filter]:backdrop-blur-md" role="banner">
            <div class="mx-auto w-full max-w-screen-xl px-4 py-3 sm:px-4 md:px-6">
              <nav class="sm:flex sm:items-center sm:justify-between sm:gap-4" aria-label="Main navigation">
                <!-- Left: wordmark -->
                <%= link_to root_path, class: "group flex flex-col sm:inline-flex sm:flex-row sm:items-baseline gap-0 sm:gap-1.5 md:gap-2 flex-shrink-0" do %>
                  <span class="text-xs tracking-[0.25em] sm:tracking-[0.2em] md:tracking-[0.28em] uppercase text-lagavulin-gold/90 transition group-hover:text-lagavulin-gold whitespace-nowrap">
                    Collective Spirits
                  </span>
                  <span class="inline-flex items-baseline gap-1 sm:gap-1.5">
                    <span class="font-of text-sm sm:text-sm md:text-base lg:text-lg leading-none text-lagavulin-gold/80">
                      of
                    </span>
                    <span class="text-xs tracking-[0.25em] sm:tracking-[0.2em] md:tracking-[0.28em] uppercase text-lagavulin-gold/90 transition group-hover:text-lagavulin-gold whitespace-nowrap">
                      Montclair
                    </span>
                  </span>
                <% end %>

                <!-- Mobile menu button (below logo on mobile) -->
                <button type="button" 
                        class="sm:hidden mt-3 inline-flex items-center gap-2 px-3 py-2 rounded-md text-lagavulin-gold/70 hover:text-lagavulin-gold hover:bg-black/20 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-lagavulin-gold/50 transition"
                        aria-controls="mobile-menu" 
                        aria-expanded="false"
                        onclick="document.getElementById('mobile-menu').classList.toggle('hidden'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'false' ? 'true' : 'false');">
                  <span class="text-base font-medium tracking-wider uppercase">Menu</span>
                  <!-- Icon when menu is closed -->
                  <svg class="block h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                  </svg>
                </button>

                <!-- Desktop nav (hidden on mobile) -->
                <div class="hidden sm:flex sm:items-center sm:gap-x-3 md:gap-x-4 lg:gap-x-6 flex-wrap">
                  <%= link_to "Home", root_path, class: "link-mini" %>
                  <%= link_to "Bottle Archive", archives_path, class: "link-mini" %>
                  <%= link_to "Tasting Archive", meetings_path, class: "link-mini" %>
                  <%= link_to "Stats", stats_path, class: "link-mini" %>
                  <a href="<%= new_meeting_path %>" class="link-mini" data-turbo-frame="modal">Schedule</a>

                  <% if user_signed_in? %>
                    <a href="<%= edit_user_registration_path %>" class="link-mini" data-turbo-frame="modal">Edit account</a>

                    <%= button_to destroy_user_session_path,
                          method: :delete,
                          form: { class: "inline" },
                          class: "btn-mini",
                          data: { turbo: false, turbo_confirm: "Log out of your account?" },
                          aria: { label: "Log out" } do %>
                      Log out
                    <% end %>
                  <% end %>
                </div>

                <!-- Mobile menu (hidden by default) -->
                <div class="hidden sm:hidden mt-3 space-y-1" id="mobile-menu">
                  <%= link_to "Home", root_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Bottle Archive", archives_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Tasting Archive", meetings_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <%= link_to "Stats", stats_path, class: "block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" %>
                  <a href="<%= new_meeting_path %>" class="block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" data-turbo-frame="modal">Schedule</a>

                  <% if user_signed_in? %>
                    <a href="<%= edit_user_registration_path %>" class="block px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition" data-turbo-frame="modal">Edit account</a>

                    <%= button_to destroy_user_session_path,
                          method: :delete,
                          form: { class: "w-full" },
                          class: "w-full text-left px-4 py-3.5 rounded-md text-base font-medium tracking-wider uppercase text-lagavulin-gold/80 hover:text-lagavulin-gold hover:bg-black/20 transition",
                          data: { turbo: false, turbo_confirm: "Log out of your account?" },
                          aria: { label: "Log out" } do %>
                      Log out
                    <% end %>
                  <% end %>
                </div>
              </nav>

              <% if user_signed_in? %>
                <p class="mt-2 meta-xs text-lagavulin-gold/70">
                  Signed in as <span class="text-lagavulin-gold/90"><%= current_user.full_name %></span>
                </p>
              <% end %>
            </div>
          </header>
        <% end %>

        <main id="main-content" class="flex-1" role="main" aria-label="Main content">
          <!-- Flash messages (centered; mobile safe) -->
          <div class="pointer-events-none fixed top-4 left-3 right-3 z-50 mx-auto max-w-xs sm:max-w-sm sm:top-6 sm:left-1/2 sm:right-auto sm:-translate-x-1/2">
            <div id="flash-messages" class="pointer-events-auto">
              <%= render "shared/flash" %>
            </div>
          </div>

          <%= yield %>
        </main>

        <% unless hide_shell %>
          <footer class="border-t border-lagavulin-gold/25 bg-lagavulin-green/40 supports-[backdrop-filter]:backdrop-blur-md py-8 sm:py-10" role="contentinfo" aria-label="Footer">
            <div class="mx-auto max-w-screen-xl px-4 text-center space-y-3 sm:px-6 sm:space-y-4">
              <p class="label-xs text-lagavulin-gold/65">
                Collective Spirits of Montclair · Est. 2023
              </p>

              <p class="meta-xs text-lagavulin-gold/65">
                A private whiskey club for friends with good taste.
              </p>
            </div>
          </footer>
        <% end %>
      </div>

    <%= turbo_frame_tag "modal" %>

    <script>
      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        // Only activate if not in an input field
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
          return;
        }
        
        // CMD/CTRL + K: Focus search (if exists)
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          const searchInput = document.querySelector('[type="search"]');
          if (searchInput) {
            searchInput.focus();
            searchInput.select();
          }
        }
        
        // G + H: Go to home
        if (e.key === 'g') {
          const nextKey = new Promise(resolve => {
            const handler = (ev) => {
              document.removeEventListener('keydown', handler);
              resolve(ev.key);
            };
            document.addEventListener('keydown', handler);
            setTimeout(() => {
              document.removeEventListener('keydown', handler);
              resolve(null);
            }, 1000);
          });
          
          nextKey.then(key => {
            if (key === 'h') window.location.href = '/';
            if (key === 'a') {
              const archiveLink = document.querySelector('a[href*=\"archives\"]');
              if (archiveLink) window.location.href = archiveLink.href;
            }
            if (key === 'n') {
              const newMeetingLink = document.querySelector('a[href*=\"meetings/new\"]');
              if (newMeetingLink) window.location.href = newMeetingLink.href;
            }
          });
        }
        
        // ?: Show keyboard shortcuts help
        if (e.shiftKey && e.key === '?') {
          e.preventDefault();
          alert('Keyboard Shortcuts:\\n\\n' +
                'g + h: Go to Home\\n' +
                'g + a: Go to Browse\n' +
                'g + n: New Tasting\\n' +
                '⌘/Ctrl + K: Focus search\\n' +
                '?: Show this help');
        }
      });

      function setupFlashFade() {
        const flashContainer = document.getElementById("flash-messages");
        if (!flashContainer) return;

        const messages = flashContainer.querySelectorAll(".flash-message");
        if (!messages.length) return;

        // Start fade after 1.6s (slightly calmer)
        setTimeout(() => {
          messages.forEach((el) => {
            el.style.opacity = "0";
            el.style.transform = "translateY(-6px)";
          });

          // Remove from DOM after transition
          setTimeout(() => {
            flashContainer.innerHTML = "";
          }, 900);
        }, 1600);
      }

      document.addEventListener("turbo:load", setupFlashFade);
      document.addEventListener("DOMContentLoaded", setupFlashFade);
    </script>
  </body>
</html>


